  m_EditorClassIdentifier: 
  itemId: 111
  indentLevel: 0
  storyText: "*\u0425\u043E\u0442\u044F \u0431\u044B \u043F\u043E C#\u2019\u0443
    \u0441\u0442\u0430\u043B\u043E \u0447\u0443\u0442\u044C \u043F\u043E\u043D\u044F\u0442\u043D\u0435\u0435.
    \u0412\u043F\u0435\u0440\u0435\u0434\u0438 \u0435\u0449\u0451 \u0434\u0432\u0430
    \u0431\u043B\u043E\u043A\u0430: Unity \u0438 Blender, \u043D\u0443\u0436\u043D\u043E
    \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C\u0441\u044F
    \u043A \u043D\u0438\u043C, \u044F \u0436\u0435 \u0445\u043E\u0447\u0443 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
    \u0445\u043E\u0440\u043E\u0448\u0443\u044E \u0438\u0433\u0440\u0443 \u0432 #\u0418\u0433\u0440\u043E\u0432\u043E\u043C\u0412\u0430\u0440\u0435\u043D\u044C\u0435,
    \u0445\u0435\u0445*\n"
