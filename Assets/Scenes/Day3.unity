  m_EditorClassIdentifier: 
  itemId: 597
  indentLevel: 0
  storyText: "\u0417\u043D\u0430\u0447\u0438\u0442 \u0442\u0430\u043A, \u0435\u0441\u043B\u0438
    \u043A\u0442\u043E \u0435\u0449\u0451 \u043D\u0435 \u0432 \u043A\u0443\u0440\u0441\u0435
    - \u0438\u0433\u0440\u0430\u0435\u043C \u0432 \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u0439
