  m_EditorClassIdentifier: 
  itemId: 780
  indentLevel: 0
  storyText: "\u041F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u044E \u0437\u0430\u0432\u0442\u0440\u0430
    \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C\u0441\u044F \u0432 \u201C\u043A\u043E\u0441\u0442\u0440\u0435\u201D,
    \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u044E \u043E\u0442\u0432\u0435\u0442\u0438\u0442\u044C
    \u043D\u0430 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u044E\u0449\u0438\u0435
    \u0432\u0430\u0441 \u0432\u043E\u043F\u0440\u043E\u0441\u044B. \u0418\u043D\u0442\u0435\u0440\u0435\u0441
    \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442?"
