  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 774
  indentLevel: 0
  storyText: "\u0412\u043E\u0442 \u0438 \u043F\u043E\u0434\u043E\u0448\u043B\u0430
    \u043A \u043A\u043E\u043D\u0446\u0443 \u043B\u0435\u043A\u0446\u0438\u044F \u043F\u043E
    \u043E\u0441\u043D\u043E\u0432\u0430\u043C Unity. \u0412 DungeonCord \u044F \u0441\u043A\u0438\u043D\u0443
    \u0432\u0441\u0435 \u043E\u0431\u0435\u0449\u0430\u043D\u043D\u044B\u0435 \u0441\u0441\u044B\u043B\u043A\u0438,
    \u0442\u0430\u043A \u0447\u0442\u043E \u043D\u0435 \u0442\u0435\u0440\u044F\u0435\u043C\u0441\u044F.
    \u0412\u0441\u0435\u043C \u043F\u043E\u043A\u0430, \u0432\u0441\u0435\u043C \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u043E,
    \u0432\u0441\u0435\u043C \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0439
    \u043D\u043E\u0447\u0438!"
