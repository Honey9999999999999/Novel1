  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 729
  indentLevel: 0
  storyText: "\u041F\u043E\u043A\u0430 \u0432\u044B \u043A\u0438\u0434\u0430\u043B\u0438
    \u0441\u0432\u043E\u0438 \u0433\u0440\u0430\u043D\u0430\u0442\u044B, \u041C\u043E\u0440\u0433\u0430\u043D
    \u0437\u0430\u0441\u0435\u043B \u0441 \u043F\u0443\u043B\u0435\u043C\u0451\u0442\u043E\u043C
    \u0438 \u043F\u043E\u043B\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u0443\u0431\u0438\u043B\u0430\u0441\u044C
    \u043E\u0431 \u043D\u0435\u0433\u043E). \u041D\u0430 \u043F\u043B\u0435\u043D\u0442
    \u0432\u044B \u043D\u0435 \u043F\u0440\u043E\u0448\u043B\u0438, \u0442\u0430\u043C
    {playerName}, \u0430 \u0434\u043B\u044F \u0425\u0430\u043D\u0438 \u0441\u043D\u044F\u0442\u044C
    \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0445\u0441\u044F \u0441 awp \u0447\u0435\u0440\u0435\u0437
    \u0441\u0438\u0442\u0438 - \u0434\u0435\u043B\u043E \u0442\u0435\u0445\u043D\u0438\u043A\u0438."
