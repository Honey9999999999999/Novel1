    \u043C\u043D\u0435 \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B. \u041C\u043D\u0435
    \u043D\u0443\u0436\u043D\u043E \u0432\u0440\u0435\u043C\u044F, \u0447\u0442\u043E\u0431\u044B
    \u043F\u0435\u0440\u0435\u0432\u0430\u0440\u0438\u0442\u044C \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E\r\n\u0412
    \u043B\u044E\u0431\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435 \u0441\u043F\u0430\u0441\u0438\u0431\u043E!\r"
