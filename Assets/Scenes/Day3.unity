    \u041D\u0438\u043A\u0430\u043A\u0438\u0445 \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0439,
    \u0447\u0442\u043E \u043C\u043D\u0435 \u0437\u0430 \u043D\u0430\u0432\u043E\u0434\u043A\u0443
    \u0447\u0442\u043E-\u0442\u043E \u043F\u0435\u0440\u0435\u043F\u0430\u0434\u0451\u0442."
