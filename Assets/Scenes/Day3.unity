  m_EditorClassIdentifier: 
  itemId: 159
  indentLevel: 0
  storyText: "\u0413\u043E\u043B\u043E\u0432\u0430 \u043A\u0440\u0443\u0433\u043E\u043C
    \u043E\u0442 \u043F\u0435\u0440\u0435\u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u044F,
