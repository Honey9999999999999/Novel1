  m_EditorClassIdentifier: 
  itemId: 875
  indentLevel: 1
  storyText: "\u0410 \u0449\u0430\u0441 \u0435\u043C\u0443 \u043D\u0443\u0436\u0435\u043D
    \u043F\u043E\u0441\u0440\u0435\u0434\u043D\u0438\u043A.\n\u041F\u0440\u0430\u0432\u0434\u0430
    \u0444\u0430\u0441\u0430\u0434\u0430 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442.
    \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u043E\u0432\u0435\u0440\u0438\u0442,
    \u0447\u0442\u043E \u044F \u0441\u0434\u0435\u043B\u0430\u043B \u043A\u0440\u0443\u0442\u0443\u044E
    \u0438\u0433\u0440\u0443, \u0430 \u0417\u0423\u0421 \u0442\u043E\u0447\u043D\u043E
    \u043C\u0435\u043B\u043E\u0447\u0438\u0442\u044C\u0441\u044F \u043D\u0435 \u0441\u0442\u0430\u043D\u0435\u0442,
    \u043D\u0430 \u043A\u043E\u043D\u0443 \u0431\u043E\u043B\u044C\u0448\u0438\u0435
    \u0434\u0435\u043D\u044C\u0433\u0438"
  description: 
