    \u0440\u0435\u0436\u0438\u043C. \u0414\u043E 21 \u043F\u043E\u0431\u0435\u0434
    \u0438\u043B\u0438 \u043D\u0438\u0447\u044C\u044F, \u0435\u0441\u043B\u0438 \u0443
    \u043E\u0431\u0435\u0438\u0445 \u0441\u0442\u043E\u0440\u043E\u043D \u043F\u043E
    20. \u0418\u0433\u0440\u0430\u0435\u043C \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u043E,
    \u043F\u043E \u043F\u043B\u0430\u043D\u0443, \u0431\u0435\u0437 \u0441\u0430\u043C\u043E\u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438!"
