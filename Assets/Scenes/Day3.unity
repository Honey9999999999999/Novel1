  storyText: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E, \u0441\u0440\u0430\u0437\u0443
    \u043A \u0434\u0435\u043B\u0443. \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043F\u0435\u0440\u0435\u0434
    \u043B\u0435\u043A\u0446\u0438\u0435\u0439 \u043D\u0430\u043C\u0435\u0447\u0430\u0435\u0442\u0441\u044F
    \u0437\u0430\u0440\u0443\u0431\u0430 \u0432 \u043A\u0441 \u0438 \u044F \u0445\u043E\u0442\u0435\u043B
