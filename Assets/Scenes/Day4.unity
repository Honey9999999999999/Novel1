  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 999
  indentLevel: 0
  storyText: "\u0415\u0441\u043B\u0438 \u0417\u0423\u0421 \u0442\u0435\u0431\u0435
    \u0442\u0430\u043A\u043E\u0439 \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0434\u0440\u0443\u0433,
    \u0442\u043E \u043F\u043E\u043F\u0440\u043E\u0441\u0438 \u0432 \u0434\u043E\u043B\u0433
    \u0443 \u043D\u0435\u0433\u043E, \u0430 \u043F\u043E\u0442\u043E\u043C \u043E\u0442\u0440\u0430\u0431\u043E\u0442\u0430\u0439.
    \u0412\u0440\u044F\u0434 \u043B\u0438 \u0443 \u0445\u043E\u0440\u043E\u0448\u0435\u0433\u043E
    \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u0430 \u0435\u0441\u0442\u044C
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B \u0441 \u0434\u0435\u043D\u044C\u0433\u0430\u043C\u0438,
    \u0430 \u0434\u0440\u0443\u0437\u044C\u044F \u043D\u0430 \u0441\u0447\u0451\u0442\u0447\u0438\u043A
    \u043E\u0431\u044B\u0447\u043D\u043E \u043D\u0435 \u0441\u0442\u0430\u0432\u044F\u0442."
  description: 
  character: {fileID: 253775064}
  portrait: {fileID: 21300000, guid: bcc00d71384aace40beecda15f2b1384, type: 3}
