--- !u!114 &1679784411
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1679784325}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 201
  indentLevel: 0
  storyText: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043C\u044B \u0438\u0437\u0443\u0447\u0438\u043C
    Blender, \u0430 \u0437\u0430\u0432\u0442\u0440\u0430 \u0443\u0436\u0435 \u0431\u0443\u0434\u0435\u043C
    \u0440\u0430\u0437\u0431\u0438\u0432\u0430\u0442\u044C\u0441\u044F \u043D\u0430
    \u043A\u043E\u043C\u0430\u043D\u0434\u044B \u0434\u043B\u044F GameJam\u2019\u0430,
    \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u044C
    \u0447\u0435\u043C \u0436\u0435 \u044F \u0445\u043E\u0442\u0435\u043B \u0431\u044B
    \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F \u0432 \u043A\u043E\u043C\u0430\u043D\u0434\u0435\u2026\r\n\u0412\u0441\u043F\u043E\u043C\u043D\u0438\u0442\u044C
    \u0431\u044B \u043A\u0430\u043A\u0438\u0435 \u201C\u0440\u043E\u043B\u0438\u201D
    \u043E\u0437\u0432\u0443\u0447\u0438\u0432\u0430\u043B Vondarm.\r\n\u0410\u0439
    \u043B\u0430\u0434\u043D\u043E, \u043B\u0443\u0447\u0448\u0435 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u044E,
    \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u0433\u0430\u0434\u0430\u0442\u044C\r\n"
  description: 
  character: {fileID: 52617192}
  portrait: {fileID: 21300000, guid: bcc00d71384aace40beecda15f2b1384, type: 3}
  voiceOverClip: {fileID: 0}
