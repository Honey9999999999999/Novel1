  storyText: "\u041F\u0440\u043E\u0448\u0443 \u043F\u0440\u0438\u043D\u044F\u0442\u044C
    \u043A \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044E \u0432\u0430\u0436\u043D\u0443\u044E
