  m_EditorClassIdentifier: 
  itemId: 1000
  indentLevel: 0
  storyText: "\u041B\u0430\u0434\u043D\u043E-\u043B\u0430\u0434\u043D\u043E, \u0445\u0440\u0435\u043D
    \u0441 \u0442\u043E\u0431\u043E\u0439 \u0438 \u0441 \u044D\u0442\u0438\u043C
    \u043B\u0430\u0433\u0435\u0440\u0435\u043C, \u0434\u0435\u043B\u0430\u0439\u0442\u0435
    \u0447\u0442\u043E \u0445\u043E\u0442\u0438\u0442\u0435\n\u042F, \u0442\u0430\u043A
    \u0443\u0436 \u0438 \u0431\u044B\u0442\u044C, \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u044E
    \u0441 \u0417\u0423\u0421\u043E\u043C"
  description: 
