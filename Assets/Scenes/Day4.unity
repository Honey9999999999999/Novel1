--- !u!114 &1679784448
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1679784325}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 239
  indentLevel: 0
  storyText: "\u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u0434\u0430\u0432\u0430\u0439\u0442\u0435
    \u0441\u043F\u0430\u0442\u044C, \u0437\u0430\u0432\u0442\u0440\u0430 \u0440\u0430\u043D\u043D\u0438\u0439
    \u043F\u043E\u0434\u044A\u0451\u043C \u0438 \u0431\u043E\u043B\u044C\u0448\u043E\u0435
    \u0434\u0435\u043B\u043E. \u0412\u0441\u0451 \u0436\u0435 \u043F\u0435\u0440\u0432\u0430\u044F
    \u043D\u0430\u0448\u0430 \u0438\u0433\u0440\u0430!"
  description: 
  character: {fileID: 288902096}
  portrait: {fileID: 21300000, guid: c22572a7fd9e1b14ab5951652dbf35fa, type: 3}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 1239960122}
--- !u!114 &1679784449
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1679784325}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 243
  indentLevel: 0
  storyText: "*\u0412\u043E\u0442 \u044F \u0438 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u043B\u0441\u044F
    \u043A \u0441\u0432\u043E\u0435\u0439 \u043C\u0435\u0447\u0442\u0435 - \u0434\u0435\u043B\u0430\u0442\u044C
    \u0438\u0433\u0440\u044B\r\n\u042F \u043D\u0430\u0434\u0435\u044E\u0441\u044C,
    \u0447\u0442\u043E \u043C\u043E\u0438\u0445 \u0437\u043D\u0430\u043D\u0438\u0439
    \u0445\u0432\u0430\u0442\u0438\u0442, \u0447\u0442\u043E\u0431\u044B \u0441\u0434\u0435\u043B\u0430\u0442\u044C
    \u0447\u0442\u043E-\u0442\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E\u0435.
    \u0425\u043E\u0442\u0435\u043B\u043E\u0441\u044C \u0431\u044B, \u043A\u043E\u043D\u0435\u0447\u043D\u043E,
    \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u044C, \u0438 \u044F \u043F\u0440\u0438\u043B\u043E\u0436\u0443
    \u0432\u0441\u0435 \u0443\u0441\u0438\u043B\u0438\u044F \u043A \u044D\u0442\u043E\u043C\u0443.
    \u041D\u043E \u043D\u0430\u043C \u0432\u0441\u0451 \u0435\u0449\u0451 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E
    \u043A\u0430\u043A\u0430\u044F \u0431\u0443\u0434\u0435\u0442 \u0442\u0435\u043C\u0430
    \u0438\u0433\u0440\u044B. \u041B\u0430\u0434\u043D\u043E, \u201C\u0443\u0442\u0440\u043E
    \u0432\u0435\u0447\u0435\u0440\u0430 \u043C\u0443\u0434\u0440\u0435\u0435\u201D,
    \u043D\u0443\u0436\u043D\u043E \u0437\u0430\u0441\u044B\u043F\u0430\u0442\u044C!*"
  description: 
  character: {fileID: 52617192}
  portrait: {fileID: 21300000, guid: bcc00d71384aace40beecda15f2b1384, type: 3}
  voiceOverClip: {fileID: 0}
