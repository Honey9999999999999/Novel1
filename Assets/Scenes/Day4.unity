  storyText: "{i}\u0422\u0430\u043A, Honey \u0432 Unity \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F\u2026\u0430
    \u043E\u043D \u0445\u043E\u0440\u043E\u0448. \u041F\u043E\u0436\u0430\u043B\u0443\u0439,
    \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u044E\u0441\u044C \u043A
