--- !u!114 &958231221
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 958230367}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1088
  indentLevel: 1
  storyText: "{i}\u0420\u0435\u0431\u044F\u0442\u0430 \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u043B\u0438\u0441\u044C
    \u0432 \u0445\u043E\u0440\u043E\u0448\u0443\u044E \u043A\u043E\u043C\u0430\u043D\u0434\u0443.
    \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u043B\u0443\u0447\u0448\u0443\u044E
    \u0438\u0437 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0445, \u043D\u043E
    \u043D\u0435\u043B\u044C\u0437\u044F \u0431\u044B\u0442\u044C \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u043C,
    \u0447\u0442\u043E \u043E\u043D\u0438 \u043F\u043E\u0431\u0435\u0434\u044F\u0442,
    \u043F\u043E\u043A\u0430 Joly \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442
    \u0432 \u0433\u0435\u0439\u043C \u0434\u0436\u0435\u043C\u0435.\n\u041D\u043E
    \u044D\u0442\u043E \u0443\u0436\u0435 \u043D\u0435 \u043C\u043E\u0451 \u0434\u0435\u043B\u043E.\n"
  description: 
  character: {fileID: 253775064}
  portrait: {fileID: 21300000, guid: bcc00d71384aace40beecda15f2b1384, type: 3}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 1913162873}
--- !u!114 &958231223
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 958230367}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1086
  indentLevel: 1
  storyText: "{i}\u0420\u0435\u0431\u044F\u0442\u0430 \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u043B\u0438\u0441\u044C
    \u0432 \u0445\u043E\u0440\u043E\u0448\u0443\u044E \u043A\u043E\u043C\u0430\u043D\u0434\u0443.
    \u042F \u0434\u0430\u0436\u0435 \u043D\u0435 \u0441\u043E\u043C\u043D\u0435\u0432\u0430\u044E\u0441\u044C
    \u0432 \u0438\u0445 \u043F\u043E\u0431\u0435\u0434\u0435. \u0415\u0441\u043B\u0438,
    \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u043D\u0435 \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F
    \u0435\u0449\u0451 \u043A\u0442\u043E-\u0442\u043E \u0432\u0440\u043E\u0434\u0435
    Joly \u0441\u043E \u0441\u0432\u043E\u0438\u043C \u043F\u043B\u0430\u043D\u043E\u043C
    \u0436\u0443\u043B\u044C\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u0430.\n\u041C\u043E\u0436\u0435\u0442,
    \u043F\u043E \u0438\u0442\u043E\u0433\u0443, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0435
    \u0438\u0433\u0440 \u044F \u0438 \u043D\u0435 \u043D\u0430\u0443\u0447\u0438\u043B\u0441\u044F,
    \u043D\u043E \u0441\u0432\u043E\u0439 \u0443\u0440\u043E\u043A, \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E,
    \u0432\u044B\u043D\u0435\u0441..."
  description: 
  character: {fileID: 253775064}
  portrait: {fileID: 21300000, guid: bcc00d71384aace40beecda15f2b1384, type: 3}
