  indentLevel: 0
  storyText: "\u041D\u0430\u0434\u043E \u0432\u0437\u044F\u0442\u044C \u0447\u0442\u043E-\u0442\u043E
    \u043F\u043E\u0433\u0440\u044B\u0437\u0442\u044C. {playerName}, \u0437\u0430\u0445\u043E\u0434\u0438
    \u043F\u043E \u0441\u0441\u044B\u043B\u043A\u0435, \u044F \u0442\u0435\u0431\u0435
    \u043A\u0438\u043D\u0443\u043B \u0435\u0435 \u0432 \u041B\u0421. \u042D\u0442\u043E
    \u0441\u0435\u0440\u0432\u0435\u0440, \u0433\u0434\u0435 \u043C\u043E\u0436\u0435\u043C
    \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0447\u0442\u043E-\u0442\u043E
    \u0432\u043C\u0435\u0441\u0442\u0435 \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u043C
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438, \u0431\u0435\u0437 \u043E\u0442\u0441\u0442\u0430\u0432\u0430\u043D\u0438\u044F
    \u0438 \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u0442\u044C \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u044E\u0449\u0435\u0435.\r\n"
