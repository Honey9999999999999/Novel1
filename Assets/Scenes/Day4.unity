  m_EditorClassIdentifier: 
  itemId: 554
  indentLevel: 0
  text: "\u0422\u0435\u0431\u0435 \u0441\u0442\u043E\u0438\u0442 \u043F\u0440\u0438\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C\u0441\u044F
    \u043A \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u0430\u043C \u043A\u043E\u0441\u0442\u0440\u0430,
    \u043E\u043D\u0438 \u043E\u0442\u0437\u044B\u0432\u0447\u0438\u0432\u044B\u0435
    \u0440\u0435\u0431\u044F\u0442\u0430. \u042F \u0443\u0436\u0435 \u044D\u0442\u043E
    \u043C\u043E\u0433\u0443 \u0441\u043A\u0430\u0437\u0430\u0442\u044C \u0441 \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u044E."
