  storyText: "\u0414\u0430, \u0441\u043F\u0430\u0441\u0438\u0431\u043E \u0447\u0442\u043E
    \u0432\u0441\u0451 \u0442\u0430\u043A \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u043E
    \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B!"
