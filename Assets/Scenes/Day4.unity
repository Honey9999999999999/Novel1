    \u0431\u0443\u0434\u0435\u0442 \u0433\u0443\u0434. \u041A\u0430\u0436\u0434\u044B\u0439
    \u0438\u0437 \u043D\u0430\u0441 \u0437\u043D\u0430\u0435\u0442 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
    \u043C\u043D\u043E\u0433\u043E. \u0421\u0434\u0435\u043B\u0430\u0435\u043C \u0447\u0442\u043E-\u0442\u043E
