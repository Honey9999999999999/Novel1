  indentLevel: 0
  storyText: "{i} \u0412\u0441\u0451 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0435
    \u0434\u043B\u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u044F
    \u0436\u0438\u0437\u043D\u0438 \u0432 \u0442\u0435\u043B\u0435 \u0438 \u0441\u0432\u044F\u0437\u0435\u0439
    \u0432 \u0436\u0438\u0437\u043D\u0438 \u0441\u0434\u0435\u043B\u0430\u043D\u043E.
    \u0415\u0441\u043B\u0438 \u041C\u043E\u0440\u0433\u0430\u043D \u0438\u043B\u0438
    \u0425\u0430\u043D\u0438 \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u043D\u0435
    \u043D\u0430\u0447\u0430\u043B\u0438 \u0441\u0432\u043E\u0438 \u0437\u0430\u043D\u044F\u0442\u0438\u044F,
    \u0442\u043E \u0435\u0449\u0451 \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
    \u0432\u0440\u0435\u043C\u044F \u0441 \u043F\u043E\u043B\u044C\u0437\u043E\u0439
    \u0434\u043B\u044F \u043C\u043E\u0437\u0433\u0430."
