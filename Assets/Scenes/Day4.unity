  indentLevel: 0
  storyText: "\u0412\u043E\u0442 \u0438 \u043F\u043E\u0434\u043E\u0448\u043B\u0430
    \u043D\u0430\u0448\u0430 \u043B\u0435\u043A\u0446\u0438\u044F \u043A \u043A\u043E\u043D\u0446\u0443.
    \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043C\u044B \u0441 \u0432\u0430\u043C\u0438
    \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u043B\u0438 \u043E\u0441\u043D\u043E\u0432\u044B
    Blender\u2019\u0430 \u0438 3D-\u043C\u043E\u0434\u0435\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F.
    \u0412\u0441\u0435\u043C \u0443\u0434\u0430\u0447\u0438 \u043D\u0430 \u0431\u0443\u0434\u0443\u0449\u0435\u043C
    GameJam\u2019\u0435 \u0438 \u0432\u0441\u0435\u043C \u043F\u043E\u043A\u0430-\u043F\u043E\u043A\u0430!"
