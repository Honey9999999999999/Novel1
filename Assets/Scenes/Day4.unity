  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1079
  indentLevel: 1
  storyText: "{i}\u0420\u0435\u0431\u044F\u0442\u0430 \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u043B\u0438\u0441\u044C
    \u0432 \u0445\u043E\u0440\u043E\u0448\u0443\u044E \u043A\u043E\u043C\u0430\u043D\u0434\u0443.
    \u042F \u0434\u0430\u0436\u0435 \u043D\u0435 \u0441\u043E\u043C\u043D\u0435\u0432\u0430\u044E\u0441\u044C
    \u0432 \u0438\u0445 \u043F\u043E\u0431\u0435\u0434\u0435. \u0425\u043E\u0440\u043E\u0448\u043E,
    \u0447\u0442\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C
    \u043F\u043E\u043C\u043E\u0447\u044C Joly \u0438 \u043E\u0442\u0433\u0432\u043E\u0440\u0438\u0442\u044C
    \u0435\u0433\u043E \u043E\u0442 \u0436\u0443\u043B\u044C\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u0430.
    \u041C\u043E\u0436\u0435\u0442, \u043F\u043E \u0438\u0442\u043E\u0433\u0443,
    \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0435 \u0438\u0433\u0440
    \u044F \u0438 \u043D\u0435 \u043D\u0430\u0443\u0447\u0438\u043B\u0441\u044F,
    \u043D\u043E \u0441\u0432\u043E\u0439 \u0443\u0440\u043E\u043A, \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E,
    \u0432\u044B\u043D\u0435\u0441..."
