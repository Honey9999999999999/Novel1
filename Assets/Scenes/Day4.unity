  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 641
  indentLevel: 0
  storyText: "\u041A\u0440\u0443\u0442\u043E! \u041C\u044B \u0441 Morgan\u2019\u043E\u043C
    \u0443\u0436\u0435 \u0432 \u043E\u0434\u043D\u043E\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u0435!
    \u0425\u043E\u0442\u044F \u043C\u044B \u043C\u043E\u0436\u0435\u043C \u043F\u0440\u0438\u041D\u042F\u0442\u044C
    \u0435\u0449\u0451 \u043E\u0434\u043D\u043E\u0433\u043E \u043B\u044E\u0431\u0438\u0442\u0435\u043B\u044F
    \u0434\u0435\u043B\u0430\u0442\u044C \u0438\u0433\u0440. \u0430 \u0443 \u043D\u0430\u0441
    \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u0440\u043E\u043B\u0438 \u0442\u043E\u043B\u044C\u043A\u043E
    \u043D\u0430: \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u0439 \u0438 C# \u041F\u0438\u0448\u0438\u0442\u0435,
    \u043A\u043E\u0433\u043E \u0437\u0430\u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u0432\u0430\u043B)\r\n"
  description: 
  character: {fileID: 253775066}
  portrait: {fileID: 21300000, guid: c22572a7fd9e1b14ab5951652dbf35fa, type: 3}
  voiceOverClip: {fileID: 0}
