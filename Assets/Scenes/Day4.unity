  m_EditorClassIdentifier: 
  itemId: 476
  indentLevel: 0
  storyText: "..\u043D\u0443 \u0447\u0442\u043E, \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
    \u043B\u0438 \u0443 \u0432\u0430\u0441 \u0432\u043E\u043F\u0440\u043E\u0441\u044B?
    \u0415\u0441\u043B\u0438 \u0434\u0430, \u0442\u043E \u043D\u0430\u043F\u0438\u0448\u0438\u0442\u0435
    \u043C\u043D\u0435 \u0432 \u041B\u0421, \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u044E.
    \u041C\u043E\u0436\u0435\u0442 \u0441\u0434\u0435\u043B\u0430\u0435\u043C \u0435\u0449\u0451
    \u043E\u0434\u043D\u0443 \u043B\u0435\u043A\u0446\u0438\u044E, \u0435\u0441\u043B\u0438
    \u043C\u043D\u0435 \u0431\u0443\u0434\u0435\u0442 \u043D\u0435 \u0432 \u043B\u043E\u043C
    \u0438 \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u043C\u0435\u043D\u044F
    \u0437\u0430\u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u0432\u0430\u0442\u044C."
