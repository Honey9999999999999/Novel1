--- !u!114 &1679784413
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1679784325}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 204
  indentLevel: 0
  storyText: "\u2026\u0421\u043B\u0443\u0448\u0430\u0439\u0442\u0435, \u044F \u0442\u0430\u043A
    \u0432\u0438\u0436\u0443, \u0447\u0442\u043E \u043B\u044E\u0434\u044F\u043C \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E
    \u0447\u0443\u0442\u044C \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u0435\u0435
    \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043F\u0440\u043E
    Unity, \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u044E \u0437\u0430\u0432\u0442\u0440\u0430
    \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C\u0441\u044F \u0432 \u201C\u043A\u043E\u0441\u0442\u0440\u0435\u201D
    \u0432 17:00, \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u044E \u043E\u0442\u0432\u0435\u0442\u0438\u0442\u044C
    \u043D\u0430 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u044E\u0449\u0438\u0435
    \u0432\u0430\u0441 \u0432\u043E\u043F\u0440\u043E\u0441\u044B, \u0430 \u043F\u043E\u0442\u043E\u043C
    \u0438 \u043F\u0440\u043E Blender \u0443\u0436\u0435 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C!\u041A\u0430\u043A
    \u0432\u0430\u043C \u0438\u0434\u0435\u044F?"
