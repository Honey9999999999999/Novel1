  indentLevel: 0
  storyText: "{i}\u0422\u0430\u043A \u0441\u0442\u043E\u043F, \u0441\u0435\u0433\u043E\u0434\u043D\u044F
    \u0436\u0435 \u0435\u0449\u0435 \u043B\u0435\u043A\u0446\u0438\u044F \u0443 Honey
    \u0438 \u0443 Morgana, \u0430 \u0447\u0442\u043E \u044F \u0445\u043E\u0447\u0443
    \u0438\u0437\u0443\u0447\u0430\u0442\u044C?\r\n\u0412\u0441\u043F\u043E\u043C\u043D\u0438\u0442\u044C
