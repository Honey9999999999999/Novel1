  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 553
  indentLevel: 0
  text: "\u0412\u0441\u043F\u043E\u043C\u043D\u0438 \u043A\u0430\u043A \u0442\u0435\u0431\u0435
    \u0431\u044B\u043B\u043E \u0445\u043E\u0440\u043E\u0448\u043E \u043E\u0442 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430
    \u0432 \u0438\u0433\u0440\u0435. \u041E\u0442\u043A\u0440\u043E\u0439\u0441\u044F
    \u043C\u0438\u0440\u0443 \u0438 \u044D\u0442\u043E\u0433\u043E \u0447\u0443\u0432\u0441\u0442\u0432\u0430
    \u0441\u0442\u0430\u043D\u0435\u0442 \u0432 \u0442\u0432\u043E\u0435\u0439 \u0436\u0438\u0437\u043D\u0438
    \u0432 \u0440\u0430\u0437\u044B \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C
    \u043A\u0440\u0430\u0442\u043A\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439
    \u043A\u0430\u0439\u0444 \u0441\u043F\u0438\u0440\u0442\u0430 \u0432 \u043A\u0440\u043E\u0432\u0438."
