--- !u!114 &1679784431
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1679784325}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 224
  indentLevel: 0
  storyText: "\u041A\u0440\u0443\u0442\u043E! \u041C\u044B \u0441 Van1exx \u0443\u0436\u0435
    \u0432 \u043E\u0434\u043D\u043E\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u0435!
    \u0425\u043E\u0442\u044F \u043C\u044B \u043C\u043E\u0436\u0435\u043C \u043F\u0440\u0438\u043D\u044F\u0442\u044C
    \u0435\u0449\u0451 \u043E\u0434\u043D\u043E\u0433\u043E \u043B\u044E\u0431\u0438\u0442\u0435\u043B\u044F
    \u0434\u0435\u043B\u0430\u0442\u044C \u0438\u0433\u0440. \u0410 \u0443 \u043D\u0430\u0441
    \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u0440\u043E\u043B\u0438 \u0442\u043E\u043B\u044C\u043A\u043E
    \u043D\u0430: \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u0439 \u0438 C#. \u041F\u0438\u0448\u0438\u0442\u0435,
    \u043A\u043E\u0433\u043E \u0437\u0430\u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u0432\u0430\u043B)"
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 0}
--- !u!114 &1679784432
