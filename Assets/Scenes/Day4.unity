--- !u!114 &958230876
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 958230367}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 693
  indentLevel: 0
  storyText: "\u0417\u043D\u0430\u0447\u0438\u0442 \u0442\u0430\u043A, \u043A\u043E\u043C\u0430\u043D\u0434\u0430,
    \u043F\u043B\u0430\u043D \u0442\u0430\u043A\u043E\u0432: \u0440\u0435\u0437\u043A\u043E
    \u0438\u0434\u0451\u0442\u0435 \u0441\u043F\u0430\u0442\u044C, \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u043C\u0441\u044F
    \u0432 9:00, \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u043C \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u0442\u044C
    \u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C!\r\n"
  description: 
  character: {fileID: 253775065}
  portrait: {fileID: 21300000, guid: 36014a1185d519b4a9438c2e39acab96, type: 3}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
