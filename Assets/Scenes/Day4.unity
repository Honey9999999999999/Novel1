  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 670
  indentLevel: 0
  storyText: "{i}\u041C\u0434\u0430, \u0432\u043E\u0442 \u0438 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0438\u0441\u044C
    \u043B\u0435\u043A\u0446\u0438\u0438. \u0414\u0443\u043C\u0430\u044E\u2026\u043F\u043E\u0441\u043B\u0435
    \u0431\u0430\u0437\u043E\u0432\u044B\u0445 \u0437\u043D\u0430\u043D\u0438\u0439,
    \u044F \u0441\u043C\u043E\u0433\u0443 \u0440\u0430\u0437\u0432\u0438\u0442\u044C
    \u0441\u0435\u0431\u044F \u0432 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u043E\u043C
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438. \u041D\u0443\u0436\u043D\u043E
    \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F,
    \u0447\u0442\u043E \u044F \u0445\u043E\u0447\u0443 \u0434\u0435\u043B\u0430\u0442\u044C
    \u0434\u0430\u043B\u044C\u0448\u0435. \r\n"
