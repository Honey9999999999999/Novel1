  storyText: "\u0410 \u043A\u043E\u0433\u0434\u0430 \u043E\u043D\u043E \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u0442?
    \u041C\u044B \u0436\u0438\u0432\u0435\u043C \u0437\u0434\u0435\u0441\u044C \u0438
    \u0441\u0435\u0439\u0447\u0430\u0441, \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u0438
    \u0437\u0430\u0431\u044B\u0432\u0430\u0442\u044C\u0441\u044F \u0432 \u0430\u043B\u043A\u0430\u0448\u043A\u0435.
    \u041E\u043D\u0430 \u0442\u0435\u0431\u0435 \u043D\u0435 \u043F\u043E\u043C\u043E\u0436\u0435\u0442."
