  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1090
  indentLevel: 0
  storyText: "\u041C\u044B \u043F\u043E\u043D\u044F\u0442\u0438\u044F \u043D\u0435
    \u0438\u043C\u0435\u0435\u043C \u0447\u0442\u043E \u0442\u0430\u043C \u0437\u0430
    \u0442\u0435\u043C\u0430, \u0434\u0430\u0432\u0430\u0439 \u043D\u0435 \u043A\u0443\u043A\u0441\u0438\u0441\u044C
    \u0438 \u0441\u043F\u0430\u0442\u044C"
  description: 
  character: {fileID: 1473289946}
  portrait: {fileID: 21300000, guid: e6d83e8064315334e9b661b73dd165f2, type: 3}
  voiceOverClip: {fileID: 0}
