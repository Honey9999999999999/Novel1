  m_EditorClassIdentifier: 
  itemId: 679
  indentLevel: 0
  storyText: "{i}\u0420\u0435\u0431\u044F\u0442\u0430 \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u043B\u0438\u0441\u044C
    \u0432 \u0445\u043E\u0440\u043E\u0448\u0443\u044E \u043A\u043E\u043C\u0430\u043D\u0434\u0443.
    \u041A\u0430\u0436\u0434\u044B\u0439 \u0438\u0437 \u043D\u0438\u0445 \u0445\u043E\u0440\u043E\u0448\u043E
    \u0437\u043D\u0430\u0435\u0442 \u043E\u0434\u043D\u043E \u0438\u0437 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0445
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0439, \u043F\u043E
    \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u0431\u044B\u043B\u0438 \u043B\u0435\u043A\u0446\u0438\u0438\u2026\u041E\u043D\u0438
    \u0441\u043C\u043E\u0433\u0443\u0442 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
    \u0432\u0435\u043B\u0438\u043A\u0443\u044E \u0438\u0433\u0440\u0443. \u0416\u0430\u043B\u044C,
    \u0447\u0442\u043E \u044F \u043D\u0435 \u0441 \u043D\u0438\u043C\u0438. \u042D\u0442\u043E
    \u0431\u0443\u0434\u0435\u0442 \u043C\u043D\u0435 \u0443\u0440\u043E\u043A\u043E\u043C\u2026\r\n"
