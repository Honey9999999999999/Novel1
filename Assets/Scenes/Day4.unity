    \u043C\u043E\u0436\u0435\u0448\u044C \u0441\u043A\u0430\u0437\u0430\u0442\u044C
    \u044D\u0442\u043E \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E \u043B\u044E\u0431\u043E\u043C\u0443
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443, \u0432\u0441\u0435 \u0432\u0441\u0451
    \u043C\u043E\u0433\u0443\u0442, \u0443 \u0432\u0441\u0435\u0445 \u0432\u0441\u0451
    \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F. \u0420\u043E\u0437\u043E\u0432\u044B\u0435
    \u043E\u0447\u043A\u0438 \u0441\u043D\u0438\u043C\u0438"
