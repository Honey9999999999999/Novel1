  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 486
  indentLevel: 0
  storyText: "\u0424\u0443\u0445, \u043D\u0443 \u0432\u0440\u043E\u0434\u0435 \u0443\u0441\u043F\u0435\u043B
    \u0432\u0441\u0451 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C
    \u0438\u0437 \u0437\u0430\u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E.
    \u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0431\u044B\u043B\u043E \u043D\u0435
    \u0441\u043A\u043E\u043C\u043A\u0430\u043D\u043E. \u0415\u0441\u043B\u0438 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
    \u0432\u043E\u043F\u0440\u043E\u0441\u044B - \u0437\u0430\u0434\u0430\u0432\u0430\u0439\u0442\u0435
    \u0432 \u043B\u0441. \u041E\u0442\u0432\u0435\u0447\u0443 \u043F\u043E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438."
  description: 
  character: {fileID: 253775065}
