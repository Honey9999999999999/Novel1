  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 977
  indentLevel: 0
  storyText: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u043A\u043E\u043D\u0435\u0447\u043D\u043E,
    \u043D\u043E \u0441\u0435\u0439\u0447\u0430\u0441 \u0443 \u043C\u0435\u043D\u044F
    \u043D\u0435\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043D\u0430 \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u0435
    \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u0433\u043E \u0443\u0441\u043F\u0435\u0445\u0430"
  description: 
  character: {fileID: 1473289946}
  portrait: {fileID: 21300000, guid: e6d83e8064315334e9b661b73dd165f2, type: 3}
  voiceOverClip: {fileID: 0}
