  indentLevel: 0
  storyText: "\u0412\u043E\u0442 \u0438 \u0437\u0434\u043E\u0440\u043E\u0432\u043E!
    \u0422\u043E\u0433\u0434\u0430 \u0436\u0434\u0451\u043C \u0437\u0430\u0432\u0442\u0440\u0430\u0448\u043D\u0438\u0439
    \u0434\u0435\u043D\u044C, \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u043C\u0441\u044F
    \u0432 9:00 \u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u043C \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u0442\u044C
    \u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C! :\u0437\r\n"
  description: 
