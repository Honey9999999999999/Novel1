  storyText: "\u0418\u0442\u0430\u043A, \u0441\u0435\u0433\u043E\u0434\u043D\u044F
    \u043C\u044B \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C \u043E \u043F\u0440\u0438\u043C\u0438\u0442\u0438\u0432\u0430\u0445,
