  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 223
  indentLevel: 0
  storyText: "\u041D\u0443 \u0447\u0442\u043E \u0440\u0435\u0431\u044F\u0442, \u043B\u0435\u043A\u0446\u0438\u0438
    \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0438\u0441\u044C, \u0430 \u0437\u043D\u0430\u0447\u0438\u0442
    \u043D\u0430\u0441\u0442\u0430\u043B\u043E \u0432\u0440\u0435\u043C\u044F \u043D\u0430\u0439\u0442\u0438
    \u0441\u0435\u0431\u0435 \u043A\u043E\u043C\u0430\u043D\u0434\u0443! \u041C\u044B
    \u0441 Morgan\u2019\u043E\u043C  \u0443\u0436\u0435 \u0432 \u043A\u043E\u043C\u0430\u043D\u0434\u0435,
    \u043D\u043E \u043C\u043E\u0436\u0435\u043C \u0432\u0437\u044F\u0442\u044C \u0435\u0449\u0451
    1 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0435 \u043A \u0441\u0435\u0431\u0435.
    \u0423 \u043D\u0430\u0441 \u043E\u0442\u043A\u0440\u044B\u0442\u0430 \u0440\u043E\u043B\u044C
    \u043D\u0430 : Unity, 3D \u0438 \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u0441\u0442\u0430."
  description: 
  character: {fileID: 1800924060}
  portrait: {fileID: 21300000, guid: 461c16a8d8359d64fb3bfbb889953e56, type: 3}
  voiceOverClip: {fileID: 0}
