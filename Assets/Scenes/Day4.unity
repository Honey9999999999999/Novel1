  indentLevel: 0
  storyText: "\u0418\u0442\u0430\u043A, \u0441\u0435\u0433\u043E\u0434\u043D\u044F
    \u043C\u044B \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C \u043E \u043F\u0440\u0438\u043C\u0438\u0442\u0438\u0432\u0430\u0445,
    \u0438 \u043D\u0435\u0442, \u043D\u0435 \u043E \u0432\u0430\u0441 \u0438 \u0432\u0430\u0448\u0435\u043C
    \u0443\u0440\u043E\u0432\u043D\u0435 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F,
    \u0430 \u043E \u043F\u0440\u0438\u043C\u0438\u0442\u0438\u0432\u043D\u044B\u0445
    \u043E\u0431\u044A\u0435\u043A\u0442\u0430\u0445, \u0438\u0437 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
    \u0441\u0442\u0440\u043E\u0438\u0442\u0441\u044F \u0431\u0430\u0437\u043E\u0432\u0430\u044F
    \u0441\u0446\u0435\u043D\u0430 \u0434\u043B\u044F \u0442\u0435\u0441\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
