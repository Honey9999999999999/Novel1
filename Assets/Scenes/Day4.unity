  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 976
  indentLevel: 0
  storyText: "\u041C\u043E\u044F \u0436\u0438\u0437\u043D\u044C \u0442\u043E\u0436\u0435
    \u043D\u0435 \u0441\u0430\u0445\u0430\u0440, \u043D\u043E \u0435\u0441\u0442\u044C
    \u0446\u0435\u043B\u0438 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u044F \u043D\u0430\u043C\u0435\u0440\u0435\u043D
    \u0434\u043E\u0431\u0438\u0432\u0430\u0442\u044C\u0441\u044F \u0441\u0432\u043E\u0438\u043C\u0438
    \u0441\u0438\u043B\u0430\u043C\u0438. \u0413\u043B\u0430\u0432\u043D\u043E\u0435
    \u043D\u0430\u0447\u0430\u0442\u044C \u0438 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
    \u043F\u0435\u0440\u0432\u044B\u0439 \u0448\u0430\u0433 \u0438 \u0442\u044B \u044D\u0442\u043E
    \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043C\u043E\u0436\u0435\u0448\u044C,
    \u044F \u0437\u043D\u0430\u044E."
