  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 50
  indentLevel: 0
  storyText: "\t\u041D\u0430 Game jam \u043C\u044B \u0431\u0443\u0434\u0435\u043C
    \u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F \u043D\u0430 \u0433\u0440\u0443\u043F\u043F\u044B,
    \u0433\u0434\u0435 \u043A\u0430\u0436\u0434\u044B\u0439 \u0431\u0443\u0434\u0435\u0442
    \u043E\u0442\u0432\u0435\u0447\u0430\u0442\u044C \u0437\u0430 \u0441\u0432\u043E\u0439
    \u0430\u0441\u043F\u0435\u043A\u0442: \u043A\u043E\u0434 \u043D\u0430 C#, Unity
    \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0430 \u0438 3D \u043C\u043E\u0434\u0435\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
    \u0432 Blender. \n\t\u0412 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438
    \u043E\u0442 \u0442\u0432\u043E\u0438\u0445 \u043D\u0430\u0432\u044B\u043A\u043E\u0432,
    \u043B\u044E\u0434\u0438 \u0438 \u0431\u0443\u0434\u0443\u0442 \u0434\u0443\u043C\u0430\u0442\u044C,
    \u0432\u0437\u044F\u0442\u044C \u0442\u0435\u0431\u044F \u0432 \u043A\u043E\u043C\u0430\u043D\u0434\u0443
    \u0438\u043B\u0438 \u043D\u0435\u0442. \u0410 \u0432\u043E\u043E\u0431\u0449\u0435
    \u043A\u043E\u043C\u0430\u043D\u0434\u044B \u0431\u0443\u0434\u0443\u0442 \u043F\u043E
    5 \u0447\u0435\u043B\u043E\u0432\u0435\u043A, \u0442\u0430\u043A \u0447\u0442\u043E,
    \u0441\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E \u0434\u043B\u044F
    \u043A\u0430\u0436\u0434\u043E\u0433\u043E  \u0431\u0443\u0434\u0435\u0442 \u043C\u0435\u0441\u0442\u043E."
