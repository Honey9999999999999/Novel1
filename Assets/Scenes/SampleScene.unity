  indentLevel: 0
  storyText: "*\u041F\u0435\u0440\u0432\u044B\u0439 \u0434\u0435\u043D\u044C, \u0430
    \u0443\u0436\u0435 \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u043B\u0441\u044F
