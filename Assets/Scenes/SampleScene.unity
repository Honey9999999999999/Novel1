  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 32
  indentLevel: 0
  storyText: "\u041D\u0443 \u0441\u043B\u0443\u0448\u0430\u0439, \u043A\u0440\u0443\u0442\u043E!
    \u0415\u0441\u043B\u0438 \u0431\u0443\u0434\u0443\u0442 \u0432\u043E\u043F\u0440\u043E\u0441\u044B
    \u0438\u043B\u0438 \u043D\u0443\u0436\u043D\u0430 \u0431\u0443\u0434\u0435\u0442
    \u043F\u043E\u043C\u043E\u0449\u044C, \u043E\u0431\u0440\u0430\u0449\u0430\u0439\u0441\u044F:
    \u043F\u043E\u043C\u043E\u0433\u0443-\u043E\u0431\u044A\u044F\u0441\u043D\u044E!"
  description: 
  character: {fileID: 1372998679}
  portrait: {fileID: 21300000, guid: 461c16a8d8359d64fb3bfbb889953e56, type: 3}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
