--- !u!114 &720610776
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 720610682}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 97
  indentLevel: 0
  storyText: "\u041F\u043E\u0434\u0434\u0435\u0440\u0436\u0443 \u0442\u0435\u043C\u0443.\n\u041E\u043F\u044B\u0442
    \u0432 3D: \u0433\u043E\u0434 \u0431\u0430\u043B\u043E\u0432\u0441\u0442\u0432\u0430
    \u043F\u043E\u0437\u0430\u0431\u044B\u0442\u044B\u0439 \u0437\u0430 \u0433\u043E\u0434\r\n\u041E\u043F\u044B\u0442
    \u0432 \u0421#: \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0432\u0438\u0434\u0435\u043E
    \u043A\u0443\u0440\u0441\u043E\u0432 \u043D\u0430 \u044E\u0442\u0443\u0431\u0435\r\n\u041F\u0440\u0435\u0434\u043F\u043E\u0447\u0442\u0435\u043D\u0438\u044F
    \u0432 \u0438\u0433\u0440\u0430\u0445: \u0420\u041F\u0413 \u0441 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C
    \u043C\u0438\u0440\u043E\u043C \u0438 \u043C\u0435\u043D\u0435\u0434\u0436\u043C\u0435\u043D\u0442\u043E\u043C\r\n\u041E\u0442\u043B\u0438\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u043D\u0430\u0432\u044B\u043A: \u0443\u043C\u0435\u044E \u0432\u044B\u0434\u0443\u043C\u044B\u0432\u0430\u0442\u044C
    \u043A\u0443\u0447\u0443 \u0434\u0435\u0442\u0430\u043B\u0435\u0439 \u0434\u043B\u044F
    \u043D\u0435\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0433\u043E
    \u0441\u044E\u0436\u0435\u0442\u0430 \u0438 \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0445\u0440\u0435\u043D \u043A\u043E\u0433\u0434\u0430 \u0441\u043C\u043E\u0433\u0443
    \u0440\u0435\u0430\u043B\u0438\u0437\u043E\u0432\u0430\u0442\u044C."
  description: 
  character: {fileID: 682109922}
  portrait: {fileID: 21300000, guid: 36014a1185d519b4a9438c2e39acab96, type: 3}
  voiceOverClip: {fileID: 0}
