  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 167
  indentLevel: 0
  storyText: "\u0422\u0430\u043A, \u043D\u0443 \u043C\u043D\u0435 21 \u0433\u043E\u0434\u0438\u043A,
    \u043E\u043F\u044B\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0435\u043E\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439,\n\u0432\u0441\u0451
    \u0438\u0449\u0443 \u0432 \u0441\u0435\u0431\u0435 \u0441\u0438\u043B\u044B \u043D\u0430\u0447\u0430\u0442\u044C
    \u0438 \u043F\u043E\u0438\u0441\u043A\u0438 \u0437\u0430\u0432\u0435\u043B\u0438
    \u0441\u044E\u0434\u0430\n\u0418\u0434\u0435\u0439 \u0434\u043B\u044F \u0438\u0433\u0440
    \u043C\u043D\u043E\u0433\u043E, \u043C\u043E\u0442\u0438\u0432\u0430\u0446\u0438\u0438
    \u0435\u0449\u0451 \u0431\u043E\u043B\u044C\u0448\u0435\n\u0415\u0441\u043B\u0438
    \u0438\u0449\u0435\u0442\u0435 \u043A\u043E\u043C\u0430\u043D\u0434\u0443 \u043D\u0430
    game jam - \u0441\u043C\u0435\u043B\u043E \u043F\u0438\u0448\u0438\u0442\u0435
    \u043C\u043D\u0435,\n\u044F \u043E\u0442\u043A\u0440\u044B\u0442 \u0434\u043B\u044F
    \u043B\u044E\u0431\u044B\u0445 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0439"
  description: 
