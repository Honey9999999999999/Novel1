  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 33
  indentLevel: 0
  storyText: "{color=aqua}{b}@{$playerName}{/b}{/color}, \u0441\u043B\u0443\u0448\u0430\u0439,
    \u0435\u0441\u043B\u0438 \u043D\u0435 \u043F\u043B\u0430\u043D\u0438\u0440\u0443\u0435\u0448\u044C
    \u0443\u0447\u0430\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C \u0432 \u0433\u0435\u0439\u043C\u0434\u0436\u0435\u043C\u0435
    \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0443, \u0442\u043E \u043C\u044B
    \u043C\u043E\u0433\u043B\u0438 \u0431\u044B \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0442\u044C\u0441\u044F
    \u0443\u0436\u0435 \u0441\u0435\u0439\u0447\u0430\u0441, \u0443 \u0442\u0435\u0431\u044F
    \u043A\u0430\u043A \u0440\u0430\u0437 \u0442\u0435 \u043D\u0430\u0432\u044B\u043A\u0438,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043C\u043D\u0435 \u043D\u0435 \u0434\u043E\u0441\u0442\u0430\u0451\u0442"
  description: 
  character: {fileID: 865534788}
  portrait: {fileID: 21300000, guid: e6d83e8064315334e9b661b73dd165f2, type: 3}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
