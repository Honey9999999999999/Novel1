  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 32
  indentLevel: 0
  storyText: "\u041D\u0435 \u0441\u0442\u0440\u043E\u0439 \u0432\u043E\u0437\u0434\u0443\u0448\u043D\u044B\u0445
    \u0437\u0430\u043C\u043A\u043E\u0432, \u0432\u044B \u0431\u044B \u0434\u043B\u044F
    \u043D\u0430\u0447\u0430\u043B\u0430 \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430
    \u0443\u0437\u043D\u0430\u043B\u0438, \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u0430\u044F
    \u0440\u0430\u0431\u043E\u0442\u0430 \u044D\u0442\u043E \u0432\u0435\u0434\u044C
    \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u043B\u0438\u0447\u0438\u0435
    \u043D\u0430\u0432\u044B\u043A\u043E\u0432."
  description: 
  character: {fileID: 675221617}
  portrait: {fileID: 21300000, guid: c22572a7fd9e1b14ab5951652dbf35fa, type: 3}
  voiceOverClip: {fileID: 0}
