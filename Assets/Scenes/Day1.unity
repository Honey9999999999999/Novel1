  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 168
  indentLevel: 0
  storyText: "\u041D\u0435 \u0440\u0430\u043D\u043E\u0432\u0430\u0442\u043E \u043B\u0438
    \u043A\u043E\u043C\u0430\u043D\u0434\u0443 \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C?
    \u042F \u0431\u044B \u043D\u0430 \u0442\u0432\u043E\u0451\u043C \u043C\u0435\u0441\u0442\u0435
    \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0438 \u043B\u0430\u0433\u0435\u0440\u044F
    \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u043B\u0441\u044F \u0441
    \u043B\u044E\u0434\u044C\u043C\u0438, \u0447\u0442\u043E\u0431\u044B \u0437\u043D\u0430\u0442\u044C
    \u0441 \u043A\u0435\u043C \u0443 \u043C\u0435\u043D\u044F \u043C\u043E\u0433\u0443\u0442
    \u0441\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0438\u043B\u0438 \u0440\u0430\u0441\u0445\u043E\u0434\u0438\u0442\u0441\u044F
    \u0432\u0437\u0433\u043B\u044F\u0434\u044B\u2026"
  description: 
  character: {fileID: 682109922}
  portrait: {fileID: 21300000, guid: 36014a1185d519b4a9438c2e39acab96, type: 3}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
