  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 96
  indentLevel: 0
  storyText: "\u041D\u0443 \u0440\u0430\u0437 \u0443\u0436 \u0442\u0430\u043A\u043E\u0439
    \u0444\u043B\u0435\u0448\u043C\u043E\u0431\r\n25 \u043B\u0435\u0442, \u041F\u043E\u0434\u043C\u043E\u0441\u043A\u043E\u0432\u044C\u0435\n\u041E\u043F\u044B\u0442
    \u0432 \u0433\u0435\u0439\u0434\u0435\u0432\u0435: \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E
    \u043F\u0440\u043E\u0431\u043E\u0432\u0430\u043B \u0432\u0441\u044F\u043A\u043E\u0435
    \u0434\u0435\u043B\u0430\u0442\u044C.\r\n\u0412 \u0434\u0435\u0442\u0441\u0442\u0432\u0435
    \u0431\u0430\u043B\u043E\u0432\u0430\u043B\u0441\u044F \u043C\u043E\u0434\u0435\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435\u043C
    \u0432 3ds max.\r\n\u0412 \u043C\u043E\u043B\u043E\u0434\u043E\u0441\u0442\u0438
    \u043F\u0438\u0441\u0430\u043B \u0443\u0447\u0435\u0431\u043D\u044B\u0435 \u043F\u0440\u043E\u0435\u043A\u0442\u044B
    \u043F\u043E \u0433\u0440\u0430\u0444\u0438\u043A\u0435\r.\n\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
    \u0442\u0440\u0438 \u0433\u043E\u0434\u0430 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E
    \u0437\u0430\u043D\u0438\u043C\u0430\u044E\u0441\u044C \u0444\u0440\u043E\u043D\u0442\u0435\u043D\u0434\u043E\u043C."
