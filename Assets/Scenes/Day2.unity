  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 211
  indentLevel: 0
  storyText: "\u0417\u0430\u0447\u0435\u043C \u0442\u0440\u0430\u0442\u0438\u0442\u044C
    \u0432\u0440\u0435\u043C\u044F \u043D\u0430 \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435
    \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u0435\u0441\u0442\u044C \u0432
    \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u043C \u0434\u043E\u0441\u0442\u0443\u043F\u0435
    \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u043C \u0443\u0433\u043B\u0443?"
  description: 
  character: {fileID: 1223397764}
  portrait: {fileID: 21300000, guid: c22572a7fd9e1b14ab5951652dbf35fa, type: 3}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
