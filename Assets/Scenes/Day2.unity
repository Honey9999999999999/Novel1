  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 143
  indentLevel: 0
  storyText: "*\u0425\u043E\u0440\u043E\u0448\u043E, \u043A\u043E\u043D\u0435\u0447\u043D\u043E,
    \u0447\u0442\u043E \u0435\u0441\u0442\u044C \u0437\u0430\u043F\u0438\u0441\u0438
    \u043B\u0435\u043A\u0446\u0438\u0439, \u043D\u043E \u043A\u0430\u043A \u0436\u0435
    \u0442\u0430\u043A \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C,
    \u0447\u0442\u043E \u044F \u043F\u0440\u043E\u0438\u0433\u0440\u0430\u043B \u0432\u0441\u0451
    \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u0432 \u043A\u0441?! \u0425\u043E\u0442\u0435\u043B
    \u0436\u0435 \u0438\u0437\u0443\u0447\u0430\u0442\u044C \u0438 \u043F\u043E\u0437\u043D\u0430\u0432\u0430\u0442\u044C
    \u044D\u0442\u043E \u0434\u0435\u043B\u043E\u2026\r\n\u0421 Jolly \u043D\u0443\u0436\u043D\u043E
    \u0431\u044B\u0442\u044C \u043F\u043E\u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u0435\u0435,
    \u0441\u0430\u043C \u043D\u0435 \u043F\u043E\u0448\u0451\u043B \u043D\u0430 \u043B\u0435\u043A\u0446\u0438\u044E,
    \u0442\u0430\u043A \u0438 \u043C\u0435\u043D\u044F \u0435\u0449\u0451 \u0432
    \u044D\u0442\u043E \u0432\u0442\u044F\u043D\u0443\u043B.\r\n\u041D\u0443\u0436\u043D\u043E
    \u0441\u0444\u043E\u043A\u0443\u0441\u0438\u0440\u043E\u0432\u0430\u0442\u044C\u0441\u044F
    \u043D\u0430 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0438 \u0438 \u043D\u0435
    \u043E\u0442\u0432\u043B\u0435\u043A\u0430\u0442\u044C\u0441\u044F!\r\n\u041B\u0430\u0434\u043D\u043E
    \u0437\u0430\u0432\u0442\u0440\u0430 \u043D\u0430\u043F\u0438\u0448\u0443 Vondarm\u2019\u0443,
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043C\u043E\u0436\u0435\u0442..*"
