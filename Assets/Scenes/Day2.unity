  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 229
  indentLevel: 0
  storyText: "\u0414\u0430, \u0434\u043B\u044F \u043D\u043E\u0432\u0438\u0447\u043A\u043E\u0432,
    \u043D\u043E \u0438\u043C \u044D\u0442\u043E\u0433\u043E \u0438 \u043D\u0435
    \u043D\u0430\u0434\u043E. \u0415\u0441\u043B\u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
    \u0437\u0430\u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u0432\u0430\u043D
    \u0432 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0438,
    \u0442\u043E \u043E\u043D \u043D\u0435 \u0441\u0442\u0430\u043D\u0435\u0442 \u0436\u0434\u0430\u0442\u044C,
    \u0447\u0442\u043E \u0435\u043C\u0443 \u0440\u0430\u0437\u0436\u0443\u044E\u0442
    \u0432\u0441\u0451 \u043E\u0442 \u0410 \u0434\u043E \u042F \u0437\u0430 \u043F\u0430\u0440\u0443
    \u0447\u0430\u0441\u043E\u0432."
  description: 
  character: {fileID: 1763390176}
  portrait: {fileID: 21300000, guid: 461c16a8d8359d64fb3bfbb889953e56, type: 3}
  voiceOverClip: {fileID: 0}
