    \u043E\u043F\u044B\u0442, \u043F\u043E\u0442\u043E\u043C\u0443 \u043F\u043E \u0431\u0440\u0430\u0442\u0441\u043A\u0438
    \u0433\u043E\u0442\u043E\u0432 \u043F\u043E\u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F
    \u0441 \u0442\u043E\u0431\u043E\u0439 \u043F\u0430\u0440\u043E\u0447\u043A\u043E\u0439
