--- !u!114 &243279880
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 243279761}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 128
  indentLevel: 0
  storyText: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435
    \u043A\u043E\u043B\u043B\u0435\u0433\u0438! \u041D\u0430\u0432\u043E\u0441\u0442\u0440\u0438\u0442\u0435
    \u0443\u0448\u043A\u0438, \u0441\u0435\u0439\u0447\u0430\u0441 \u0431\u0443\u0434\u0435\u0442
    \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u0430\u044F \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F:\r\n\u0418\u0442\u0430\u043A,
    \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0431\u0443\u0434\u0443 \u0432\u0430\u043C
    \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C \u043E
    \u0442\u043E\u043C, \u0447\u0442\u043E \u0436\u0435\u043D\u0449\u0438\u043D \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u043B\u0438
    \u043C\u0430\u0440\u043A\u0435\u0442\u043E\u043B\u043E\u0433\u0438. \u041D\u0430
    \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435 \u0438\u0445 \u043D\u0435
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442, \u044D\u0442\u043E
    \u043D\u0443\u0436\u043D\u043E, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0442\u044C
    \u0446\u0432\u0435\u0442\u044B \u0438 \u043E\u0431\u0440\u0443\u0447\u0430\u043B\u044C\u043D\u044B\u0435
    \u043A\u043E\u043B\u044C\u0446\u0430. \u041D\u0430 \u0441\u0430\u043C\u043E\u043C
    \u0434\u0435\u043B\u0435 \u0432\u0441\u0435 \u0436\u0435\u043D\u0449\u0438\u043D\u044B
    \u0441\u0433\u0435\u043D\u0435\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
    \u043D\u0435\u0439\u0440\u043E\u0441\u0435\u0442\u044C\u044E, \u0430 \u041B\u0443\u043D\u0430
    - \u044D\u0442\u043E \u0433\u043B\u043E\u0431\u0430\u043B\u044C\u043D\u044B\u0439
    \u043F\u0440\u043E\u0435\u043A\u0442\u043E\u0440, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043F\u0440\u043E\u0435\u0446\u0438\u0440\u0443\u0435\u0442 \u0438\u0445 \u0432
    \u043D\u0430\u0448 \u043C\u0438\u0440, \u0432 \u043D\u0430\u0448\u0435 \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0435
