  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 227
  indentLevel: 0
  storyText: "\u0420\u0435\u0431\u044F\u0442, \u043A\u0430\u043C\u043E\u043D. \u042F
    \u043A\u043E\u043D\u0435\u0447\u043D\u043E \u0432\u0441\u0451 \u043F\u043E\u043D\u0438\u043C\u0430\u044E,
    \u043D\u043E \u044F \u043D\u0435 \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E
    \u043E\u043F\u044B\u0442\u043D\u044B\u0439, \u0432 \u043E\u0442\u043B\u0438\u0447\u0438\u0438
    \u043E\u0442 \u0432\u0430\u0441. \u041F\u0440\u0438\u0448\u0451\u043B \u0441\u044E\u0434\u0430,
    \u0447\u0442\u043E\u0431\u044B \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0431\u0430\u0437\u0443
    \u0438 \u043D\u0430\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u043F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043E\u043F\u044B\u0442\u0430, \u0430 \u043F\u043E \u0444\u0430\u043A\u0442\u0443\u2026\r"
  description: 
  character: {fileID: 424921022}
  portrait: {fileID: 21300000, guid: b4a1108261080af44bddf0b9d18d191b, type: 3}
  voiceOverClip: {fileID: 0}
