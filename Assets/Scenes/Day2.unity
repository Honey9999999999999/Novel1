--- !u!114 &243279944
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 243279761}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 209
  indentLevel: 0
  storyText: "\u0421\u0430\u043C \u043D\u0430\u043F\u0440\u043E\u0441\u0438\u043B\u0441\u044F.
    \u041F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u044E \u043E\u0434\u0438\u043D
    \u0440\u0430\u0437: \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u044F, \u0434\u043B\u044F
    \u0432\u0441\u0435\u0445 \u0436\u0435\u043B\u0430\u044E\u0449\u0438\u0445 \u0438
    \u041D\u0415 \u041E\u0427\u0415\u041D\u042C \u043F\u0440\u043E\u0432\u0435\u0434\u0443
    \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E \u043B\u0435\u043A\u0446\u0438\u044E
    \u0441 \u0410\u0437\u0430\u043C\u0438 \u0434\u043B\u044F \u0441\u0430\u043C\u044B\u0445
    \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0445 \u0438 \u0441 \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u0439
    \u0441\u0432\u044F\u0437\u044C\u044E. \u041F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0435
    \u043F\u0435\u0440\u0435\u0434 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439
    \u043B\u0435\u043A\u0446\u0438\u0435\u0439."
  description: 
  character: {fileID: 1763390176}
  portrait: {fileID: 21300000, guid: 461c16a8d8359d64fb3bfbb889953e56, type: 3}
  voiceOverClip: {fileID: 0}
