  storyText: "{i}\u041D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E \u043E\u043D\u0438
    \u0442\u0443\u0442 \u043D\u0430\u0441\u0442\u0440\u043E\u0447\u0438\u043B\u0438.
    \u041D\u0435\u0442 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F
    \u0447\u0438\u0442\u0430\u0442\u044C, \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
    \u043A\u0430\u043A\u0430\u044F-\u0442\u043E \u043F\u0443\u0441\u0442\u0430\u044F
    \u0434\u0438\u0441\u043A\u0443\u0441\u0441\u0438\u044F. \u0410 \u0432\u043E\u0442
    \u0432 \u043A\u043E\u0441\u0442\u0440\u0435 \u0447\u0442\u043E-\u0442\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442,
    \u043D\u0430\u0434\u043E \u0431\u044B \u0437\u0430\u0433\u043B\u044F\u043D\u0443\u0442\u044C."
