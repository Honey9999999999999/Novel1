    \u0432 \u0433\u043E\u043B\u043E\u0441\u043E\u0432\u043E\u0439, \u043F\u043E\u043A\u0430\u0436\u0443
    \u043A\u043E\u0435-\u0447\u0442\u043E, \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E
    \u043C\u043D\u0435\u043D\u0438\u0435 \u043A\u043E\u043C\u043F\u0435\u0442\u0435\u043D\u0442\u043D\u044B\u0445
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u0435\u0439
    \u0438\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u0430))"
