    \u043B\u044E\u0431\u0443\u044E \u0438\u0437 \u0441\u043E\u0442\u043D\u0438 \u043B\u0435\u043A\u0446\u0438\u0439
    \u043F\u043E \u0431\u0430\u0437\u0435 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F.\r\n"
