  m_EditorClassIdentifier: 
  itemId: 356
  indentLevel: 1
  storyText: "\u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u043F\u043E\u0441\u043B\u0435\u0437\u0430\u0432\u0442\u0440\u0430,
    \u0432 \u044D\u0442\u043E \u0436\u0435 \u0432\u0440\u0435\u043C\u044F, \u0447\u0442\u043E\u0431\u044B
    \u043D\u0435 \u043D\u0430\u0433\u0440\u0443\u0436\u0430\u0442\u044C \u043B\u044E\u0434\u0435\u0439
    \u043C\u043E\u0434\u0435\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435\u043C
    \u043F\u0435\u0440\u0435\u0434 \u043B\u0435\u043A\u0446\u0438\u0435\u0439 \u043F\u043E
    \u0434\u0432\u0438\u0436\u043A\u0443. \u0414\u0430 \u0438 \u043C\u043D\u0435
    \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u0441\u044F \u043D\u0430\u0434\u043E."
  description: 
  character: {fileID: 946677511}
