--- !u!114 &243279980
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 243279761}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 228
  indentLevel: 0
  storyText: "\u0414\u0435\u043B\u043E \u043D\u0435 \u0432 \u044D\u0442\u043E\u043C,
    \u0430 \u0432 \u0442\u043E\u043C, \u0447\u0442\u043E \u043D\u0430 \u043B\u0435\u043A\u0446\u0438\u044F\u0445
    \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u201C\u0431\u0430\u0437\u043E\u0432\u044B\u0435\u201D
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0443\u043F\u0443\u0441\u043A\u0430\u044E\u0442,
    \u0434\u0435\u043B\u0430\u044F \u0438\u0445 \u0443\u0436\u0435 \u043C\u0430\u0448\u0438\u043D\u0430\u043B\u044C\u043D\u043E.
    \u042F \u0431\u0430\u043D\u0430\u043B\u044C\u043D\u043E \u043D\u0435 \u043C\u043E\u0433\u0443
    \u043E\u0442\u0441\u043B\u0435\u0434\u0438\u0442\u044C \u043A\u0443\u0434\u0430
    \u043D\u0430\u0434\u043E \u0431\u044B\u043B\u043E \u0449\u0435\u043B\u043A\u043D\u0443\u0442\u044C.
    \u041D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u0439
    \u0441\u0432\u044F\u0437\u0438 \u0432 \u044D\u0442\u043E\u043C \u0434\u0435\u043B\u0435."
  description: 
  character: {fileID: 424921022}
  portrait: {fileID: 21300000, guid: b4a1108261080af44bddf0b9d18d191b, type: 3}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
