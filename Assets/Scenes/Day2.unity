  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 273
  indentLevel: 0
  storyText: "\u0425\u0430\u043D\u0438, \u0437\u0430\u043A\u0440\u0443\u0433\u043B\u044F\u0435\u043C\u0441\u044F,
    \u0449\u0430\u0441 \u0443\u0436\u0435 \u043B\u044E\u0434\u0438 \u043D\u0430\u0447\u043D\u0443\u0442
    \u0441\u0442\u044F\u0433\u0438\u0432\u0430\u0442\u044C\u0441\u044F \u043D\u0430
    \u043C\u043E\u0439 \u0434\u0432\u0438\u0436, \u0442\u044B \u0438\u0445 \u0441\u0432\u043E\u0438\u043C\u0438
    \u0448\u0430\u0440\u0430\u043C\u0438 \u0441\u043F\u0443\u0433\u043D\u0451\u0448\u044C.
    \u0414\u0430 \u0438 \u043C\u0435 \u043D\u0430\u0434\u043E \u043C\u0430\u043B\u043E\u0441\u0442\u044C
    \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u0441\u044F."
