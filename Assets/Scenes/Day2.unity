  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 121
  indentLevel: 0
  storyText: "\u0422\u0430\u043A \u0421\u0430\u043A\u0443\u0442\u0438\u043D \u0436\u0435
    \u0433\u043E\u0432\u043E\u0440\u0438\u043B, \u0447\u0442\u043E \u043B\u0435\u043A\u0446\u0438\u044F
    \u0431\u043E\u043B\u044C\u0448\u0435 \u043F\u0440\u043E \u0438\u0434\u0435\u043E\u043B\u043E\u0433\u0438\u044E
    \u0438 \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0438\u044E, \u0447\u0435\u043C
    \u201C\u0433\u0430\u0439\u0434\u043E\u0432\u201D \u043F\u043E \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u044F\u043C.
    \u0415\u0441\u043B\u0438 \u0432\u0430\u043C \u043D\u0443\u0436\u043D\u0430 \u0431\u0430\u0437\u0430,
    \u0442\u043E \u0438\u0434\u0438\u0442\u0435 \u043D\u0430 \u042E\u0442\u0443\u0431/\u041C\u0435\u0442\u0430\u043D\u0438\u0442
    \u0438 \u0442\u0430\u043C \u0443\u0436\u0435 \u0438\u0437\u0443\u0447\u0430\u0439\u0442\u0435
    \u0441\u0438\u043D\u0442\u0430\u043A\u0441\u0438\u0441."
