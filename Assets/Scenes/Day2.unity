  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 120
  indentLevel: 0
  storyText: "\u041D\u0435\u043F\u043B\u043E\u0445\u043E, \u043C\u043D\u0435 \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u043E\u0441\u044C,
    \u0447\u0442\u043E \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B\u0438
    \u043E \u0444\u0438\u0448\u043A\u0430\u0445 \u0438, \u0432 \u0446\u0435\u043B\u043E\u043C,
    \u043F\u043E\u0434\u0445\u043E\u0434 \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u044F
    \u043A\u0430\u043A \u044D\u0442\u043E \u0432\u0441\u0451 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442,
    \u0430 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u0443\u0447\u0438\u0432\u0430\u043D\u0438\u0435
    \u0441\u0438\u043D\u0442\u0430\u043A\u0441\u0438\u0441\u0430, \u043A\u0430\u0436\u0435\u0442\u0441\u044F
    \u043C\u043D\u0435 \u0440\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u043C\r\n\u041D\u043E
    \u044F \u0441\u043A\u0430\u0436\u0443 \u0442\u0430\u043A: \u0435\u0441\u043B\u0438
    \u0431\u044B \u044F \u0434\u043E \u044D\u0442\u043E\u0433\u043E \u043D\u0435
    \u0438\u0437\u0443\u0447\u0430\u043B C#, \u043C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
    \u0447\u0442\u043E \u044F \u043D\u0430 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435
    \u0443\u0436\u0435 \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u043B \u0431\u044B
    \u043D\u0438\u0447\u0435\u0433\u043E"
  description: 
