--- !u!114 &333880433
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 333880415}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 138
  indentLevel: 0
  storyText: "\u0412 \u0432\u044B\u0445\u043E\u0434\u043D\u044B\u0435 \u044F \u043F\u0440\u043E\u0431\u043E\u0432\u0430\u043B
    \u043E\u0442\u0432\u043B\u0435\u0447\u044C\u0441\u044F, \u0441\u043C\u043E\u0442\u0440\u0435\u043B
    \u0440\u0430\u0437\u043D\u044B\u0435 \u0433\u0430\u0439\u0434\u044B, \u0441\u043B\u0435\u0434\u0438\u043B
    \u0437\u0430 \u043D\u043E\u0432\u0438\u043D\u043A\u0430\u043C\u0438 \u0438\u0433\u0440\u043E\u0432\u043E\u0439
    \u0438\u043D\u0434\u0443\u0441\u0442\u0440\u0438\u0438, \u0430\u043D\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043B
    \u0440\u0430\u0437\u043D\u044B\u0435 \u0438\u043D\u0442\u0435\u0440\u0432\u044C\u044E
    \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u043E\u0432.
    \r\n\u0412 \u043E\u0434\u0438\u043D \u0438\u0437 \u0442\u0430\u043A\u0438\u0445
    \u0432\u0435\u0447\u0435\u0440\u043E\u0432, \t\u0431\u043B\u043E\u0433\u0435\u0440,
    \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u044F \u043F\u043E\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u043B\u0441\u044F
    \u0441 \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u0438\u0435\u043C \u0447\u0435\u043C\u0443-\u0442\u043E
    \u043D\u0430\u0443\u0447\u0438\u0442\u0441\u044F, \u0440\u0435\u0448\u0438\u043B
    \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u0442\u044C \u201C\u041E\u0441\u0435\u043D\u043D\u0438\u0439
    game dev \u043B\u0430\u0433\u0435\u0440\u044C\u201D.  \xAB\u0410 \u0432\u0435\u0434\u044C
    \u0442\u0430\u043C \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0443\u0447\u0438\u0442\u044C\u0441\u044F
    \u043C\u043D\u043E\u0433\u043E\u043C\u0443 \u0438 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
    \u0432 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0435 \u0432\u0440\u0435\u043C\u044F,
    - \u043F\u043E\u0434\u0443\u043C\u0430\u043B \u044F. \u2013 \xAB\u0413\u0434\u0435
    \u0442\u0430\u043A\u0438\u0435 \u0436\u0435 \u043A\u0430\u043A \u044F, \u0441\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C
    \u0432\u043C\u0435\u0441\u0442\u0435, \u0447\u0442\u043E\u0431\u044B \u043F\u0435\u0440\u0435\u0431\u043E\u0440\u043E\u0442\u044C
    \u043B\u0435\u043D\u044C \u0438 \u043D\u0430\u0447\u0430\u0442\u044C \u0434\u0435\u043B\u0430\u0442\u044C
    \u0438\u0433\u0440\u044B. \u041B\u0438\u0431\u043E \u0441\u0435\u0439\u0447\u0430\u0441,
    \u043B\u0438\u0431\u043E \u043D\u0438\u043A\u043E\u0433\u0434\u0430...\xBB\r\n"
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 1278428960}
