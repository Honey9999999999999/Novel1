--- !u!114 &333880416
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 333880415}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1
  indentLevel: 0
  storyText: "\u0412\u0441\u044E \u0441\u043E\u0437\u043D\u0430\u0442\u0435\u043B\u044C\u043D\u0443\u044E
    \u0436\u0438\u0437\u043D\u044C \u044F \u043C\u0435\u0447\u0442\u0430\u043B \u043E
    \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0438 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0438\u0433\u0440\u044B. \u041C\u0435\u043D\u044F \u0442\u044F\u043D\u0443\u043B\u0430
    \u044D\u0442\u0430 \u0438\u043D\u0434\u0443\u0441\u0442\u0440\u0438\u044F: \u0435\u0451
    \u043C\u0438\u0440\u044B, \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0438,
    \u0441\u044E\u0436\u0435\u0442\u044B, \u0436\u0430\u043D\u0440\u044B\u2026\u042F
    \u0445\u043E\u0442\u0435\u043B \u043E\u043A\u0443\u043D\u0443\u0442\u044C\u0441\u044F
    \u0432 \u044D\u0442\u043E \u0441 \u0433\u043E\u043B\u043E\u0432\u043E\u0439,
    \u043D\u043E \u043C\u0435\u043D\u044F \u043F\u043E\u0433\u043B\u043E\u0442\u0438\u043B\u0430
    \u0440\u0443\u0442\u0438\u043D\u0430.\r\n\u041F\u043E\u0441\u043B\u0435 \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u044F
    \u0443\u0447\u0451\u0431\u044B \u044F \u0443\u0441\u0442\u0440\u043E\u0438\u043B\u0441\u044F
    \u043D\u0430 \u043D\u0435\u0436\u0435\u043B\u0430\u043D\u043D\u0443\u044E \u0440\u0430\u0431\u043E\u0442\u0443,
    \u043B\u0438\u0448\u044C \u0431\u044B \u0438\u043C\u0435\u0442\u044C \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
    \u0434\u0435\u043D\u044C\u0433\u0438 \u0438 \u043D\u0435 \u0441\u0438\u0434\u0435\u0442\u044C
    \u043D\u0438 \u0443 \u043A\u043E\u0433\u043E \u043D\u0430 \u0448\u0435\u0435,
    \u043F\u0430\u0440\u0430\u043B\u043B\u0435\u043B\u044C\u043D\u043E \u043E\u0442\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044F
    \u043D\u0430 \xAB\u0431\u0443\u0434\u0443\u0449\u0438\u0435\xBB \u043F\u0440\u043E\u0435\u043A\u0442\u044B,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0431\u044B\u043B\u0438 \u043B\u0438\u0448\u044C
    \u0443 \u043C\u0435\u043D\u044F \u0432 \u0433\u043E\u043B\u043E\u0432\u0435.
    \u041F\u0440\u043E\u0441\u044B\u043F\u0430\u044F\u0441\u044C, \u043D\u0435\u043E\u0445\u043E\u0442\u043D\u043E
    \u0437\u0430\u0432\u0442\u0440\u0430\u043A\u0430\u043B, \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0441\u044F
    \u0438 \u0435\u0445\u0430\u043B \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0443,
    \u0433\u0434\u0435 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043D\u0435
    \u0445\u043E\u0442\u0435\u043B. \u0412\u0435\u0441\u044C \u0434\u0435\u043D\u044C
    \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u043B \u0432 \u0440\u0430\u0437\u0434\u0443\u043C\u044C\u044F\u0445
    \u043E\u0431 \u0443\u043F\u0443\u0449\u0435\u043D\u043D\u044B\u0445 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044F\u0445.
    \u0414\u043E\u0431\u0438\u0440\u0430\u043B\u0441\u044F \u0434\u043E\u043C\u043E\u0439
    \u0438\u2026 \u0437\u0430\u0441\u044B\u043F\u0430\u043B. \u0422\u0430\u043A \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B
    \u043B\u044E\u0431\u043E\u0439 \u0440\u0430\u0431\u043E\u0447\u0438\u0439 \u0434\u0435\u043D\u044C.
    \r\n"
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
