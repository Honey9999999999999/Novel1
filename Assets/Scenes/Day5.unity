  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 468
  indentLevel: 0
  storyText: "{i}\u041D\u043E \u043D\u0435 \u0443 \u043D\u0430\u0441. \u0417\u0430
    \u043C\u043D\u043E\u0439 \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u043E\u0441\u044C
    \u043E\u0442\u0434\u0430\u0442\u044C \u0442\u0435\u043C\u0443 \u043D\u0430 \u043E\u0442\u043A\u0443\u043F
    \u0434\u0440\u0430\u043A\u043E\u0448\u0435, \u043F\u043E\u043A\u0430 Joly \u0431\u0435\u0441\u0441\u043E\u0432\u0435\u0441\u0442\u043D\u043E
    \u043E\u0442\u0441\u044B\u043F\u0430\u043B\u0441\u044F.\n\u041E\u043D\u0430,
    \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u043F\u043E\u0432\u043E\u0437\u043C\u0443\u0449\u0430\u043B\u0430\u0441\u044C
    \u043D\u0430 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0442\u043E\u0440\u043E\u0432
    \u043B\u0430\u0433\u0435\u0440\u044F, \u043D\u043E \u0434\u0435\u043D\u044C\u0433\u0438
    \u0435\u0441\u0442\u044C \u0434\u0435\u043D\u044C\u0433\u0438."
  description: 
  character: {fileID: 1896540577}
  portrait: {fileID: 21300000, guid: bcc00d71384aace40beecda15f2b1384, type: 3}
