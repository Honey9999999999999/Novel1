  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 878
  indentLevel: 0
  storyText: "{i}\u0412\u0441\u0451 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u043E\u0441\u044C
    \u0432 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0432\u0438\u0438 \u0441
    \u043C\u043E\u0438\u043C\u0438 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044F\u043C\u0438.
    Joly \u043F\u043E\u0431\u0435\u0434\u0438\u043B, \u043E\u0431\u0440\u0451\u043B
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0432\u0435\u0440\u043D\u0443\u0442\u044C
    \u0434\u043E\u043B\u0433\u0438 \u0438 \u0437\u0430\u0436\u0438\u0442\u044C \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0439
    \u0436\u0438\u0437\u043D\u044C\u044E. \u0412\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
    \u043B\u0438 \u043E\u043D \u0435\u044E - \u0443\u0436\u0435 \u0435\u0433\u043E
    \u0434\u0435\u043B\u043E."
  description: 
  character: {fileID: 1896540577}
  portrait: {fileID: 21300000, guid: bcc00d71384aace40beecda15f2b1384, type: 3}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
