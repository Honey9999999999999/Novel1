  indentLevel: 1
  storyText: "{i}\u0420\u0430\u0431\u043E\u0442\u0430 \u0448\u043B\u0430 \u043F\u043E\u043B\u043D\u044B\u043C
    \u0445\u043E\u0434\u043E\u043C.\n\u0411\u043B\u0430\u0433\u043E, \u0447\u0442\u043E
    \u043F\u043E\u043C\u0438\u043C\u043E \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0438\u0445
    \u0438\u0434\u0435\u0439, Van1exx \u0442\u0430\u043A \u0436\u0435 \u0438\u043C\u0435\u0435\u0442
    \u0441\u0446\u0435\u043D\u0430\u0440\u043D\u044B\u0439 \u0442\u0430\u043B\u0430\u043D\u0442,
    \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
    \u043D\u0430 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435 \u043F\u0440\u0435\u0437\u0435\u043D\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0433\u043E
    \u0440\u043E\u043B\u0438\u043A\u0430 \u0432 \u0440\u0430\u043C\u043A\u0430\u0445
    \u0434\u0432\u0443\u0445 \u0434\u043D\u0435\u0439."
