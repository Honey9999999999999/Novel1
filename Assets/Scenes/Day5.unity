  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 456
  indentLevel: 0
  storyText: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435
    \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0449\u0438\u0435 \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u0438!
    \r\n\r\n\u041D\u0430 \u044D\u0442\u043E\u043C \u0434\u0436\u0435\u043C\u0435
    \u0432\u044B \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u0431\u043E\u0440\u0438\u0442\u0435\u0441\u044C
    \u0437\u0430 \u043F\u0440\u0438\u0437 \u0432 300.000 \u0440\u0443\u0431\u043B\u0435\u0439
    \u043D\u043E \u043E\u0441\u0432\u043E\u0438\u0442\u0435 \u043E\u0434\u0438\u043D
    \u043F\u0435\u0440\u0432\u0438\u0447\u043D\u044B\u0445 \u043D\u0430\u0432\u044B\u043A\u043E\u0432
    \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u0430 - \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C
    \u0438\u0437 \u0433\u043E\u0432\u043D\u0430 \u0438 \u043F\u0430\u043B\u043E\u043A
    \u0443\u0432\u043B\u0435\u043A\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u0438\u0433\u0440\u044B."
  description: 
  character: {fileID: 1896540578}
  portrait: {fileID: 21300000, guid: 5b0b22adeec0b7e44baeb87d25d1feaf, type: 3}
  voiceOverClip: {fileID: 0}
