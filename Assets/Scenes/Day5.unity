  m_EditorClassIdentifier: 
  itemId: 930
  indentLevel: 1
  storyText: "\u042F \u0437\u0430\u043C\u0435\u0442\u0438\u043B, \u0447\u0442\u043E
    \u0443 \u0442\u0435\u0431\u044F \u0441 \u0433\u0435\u0439\u043C \u0434\u0436\u0435\u043C\u043E\u043C
    \u043D\u0435 \u0441\u043B\u043E\u0436\u0438\u043B\u043E\u0441\u044C \u0438 \u0440\u0435\u0448\u0438\u043B,
    \u0447\u0442\u043E \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u0437\u0430\u0445\u043E\u0442\u0435\u0442\u044C
    \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u0441\u044F \u0441
    \u0417\u0423\u0421\u043E\u043C. \u0417\u0430 \u0431\u0435\u0441\u0435\u0434\u043E\u0439
    \u0447\u0442\u043E-\u0442\u043E \u0434\u0430 \u043D\u0430\u043A\u043B\u044E\u043D\u0435\u0442\u0441\u044F.
    \u0422\u0430\u043A \u0447\u0442\u043E \u0442\u044B \u043F\u0438\u0448\u0438,
    \u0435\u0441\u043B\u0438 \u0432\u0434\u0440\u0443\u0433 \u043D\u0430\u0434\u0443\u043C\u0430\u0435\u0448\u044C!"
