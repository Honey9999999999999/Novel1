  indentLevel: 0
  storyText: "\u0420\u0435\u0431\u044F\u0442\u0430, \u043C\u044B \u0432\u0441\u0435
    \u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u043C\u043E\u043B\u043E\u0434\u0446\u044B
    \u0438 \u0443 \u043D\u0430\u0441 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0430\u0441\u044C
    \u043F\u0440\u0435\u0432\u043E\u0441\u0445\u043E\u0434\u043D\u0430\u044F \u0438\u0433\u0440\u0430!
    \u0422\u0435\u043F\u0435\u0440\u044C \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
    \u0442\u043E\u043B\u044C\u043A\u043E \u0436\u0434\u0430\u0442\u044C \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043E\u0432"
