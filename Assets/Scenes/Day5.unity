  m_EditorClassIdentifier: 
  itemId: 876
  indentLevel: 0
  storyText: "{i}\u041A\u043E\u0433\u0434\u0430 \u0436\u0435 \u043D\u0430\u0441\u0442\u0430\u043B
    \u0434\u0435\u043D\u044C \u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u044F
    \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043E\u0432, \u043C\u044B
    \u0431\u044B\u043B\u0438 \u0433\u043E\u0442\u043E\u0432\u044B \u043A \u043F\u0435\u0440\u0432\u0435\u043D\u0441\u0442\u0432\u0443,
    \u043D\u043E \u043D\u0430 \u043F\u0443\u0431\u043B\u0438\u043A\u0435 \u0432\u044B\u0440\u0430\u0436\u0430\u043B\u0438
    \u043D\u0435\u043F\u043E\u043C\u0435\u0440\u043D\u0443\u044E \u0440\u0430\u0434\u043E\u0441\u0442\u044C
    \u0438 \u043F\u0440\u0438\u0437\u043D\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C.\n\n"
