  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 842
  indentLevel: 0
  storyText: "{i}\u041D\u0430 \u043C\u043E\u0438 \u043D\u0435\u043C\u043D\u043E\u0433\u043E\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u044B\u0435
    \u043F\u043E\u043F\u044B\u0442\u043A\u0438 \u0432\u043D\u0435\u0441\u0442\u0438
    \u0441\u0432\u043E\u044E \u043B\u0435\u043F\u0442\u0443, \u0417\u0435\u043B\u0435\u0431\u043E\u0431\u0430
    \u043E\u0442\u0448\u0443\u0447\u0438\u0432\u0430\u043B\u0430\u0441\u044C. \n\u0414\u0436\u043E\u043B\u0438
    \u0432\u0441\u043A\u043E\u0440\u0435 \u0441\u043A\u0430\u0437\u0430\u043B \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u044C
    \u0435\u0439 \u0434\u0435\u043B\u0430\u0442\u044C \u0441\u0432\u043E\u0451 \u0434\u0435\u043B\u043E
    \u0438 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u0441\u043A\u043E\u0440\u043E\u0442\u0430\u0442\u044C
    \u0432\u0440\u0435\u043C\u044F \u0432 \u043A\u0430\u043A\u043E\u043C-\u043D\u0438\u0431\u0443\u0434\u044C
    \u0448\u0443\u0442\u0435\u0440\u0435 \u043F\u043E\u0441\u0432\u0435\u0436\u0435\u0435
    \u043A\u0441 1.6."
