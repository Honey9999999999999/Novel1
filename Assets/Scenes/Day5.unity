  m_EditorClassIdentifier: 
  itemId: 826
  indentLevel: 1
  storyText: "{i}\u0412 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0435 \u0440\u0430\u0431\u043E\u0442\u044B
    \u043F\u043E\u044F\u0432\u0438\u043B\u043E\u0441\u044C \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435,
    \u0447\u0442\u043E \u043D\u0430 Ren'py \u0434\u0435\u043B\u0430\u0442\u044C \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u044B\u0435
    \u043D\u043E\u0432\u0435\u043B\u043B\u044B \u043F\u043E \u0441\u0432\u043E\u0435\u043C\u0443
    \u043B\u0435\u0433\u043A\u043E, \u043D\u043E \u043F\u043E\u043A\u043E\u0440\u0438\u0442\u044C
    \u044D\u0442\u0443 \u0432\u0435\u0440\u0448\u0438\u043D\u0443, \u0441\u0438\u0434\u044F
    \u043D\u0430 \u0438\u043D\u0432\u0430\u043B\u0438\u0434\u043D\u043E\u0439 \u043A\u043E\u043B\u044F\u0441\u043A\u0435
    - \u044D\u0442\u043E \u0432\u044B\u0437\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u044F \u043D\u0435 \u043C\u043E\u0433\u0443 \u043D\u0435 \u043F\u0440\u0438\u043D\u044F\u0442\u044C."
