  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 201
  indentLevel: 0
  storyText: "*\u0423\u0442\u0440\u043E\u043C \u044F \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0441\u044F
    \u0437\u0430 \u043F\u043E\u043B\u0447\u0430\u0441\u0430 \u0434\u043E \u043D\u0430\u0447\u0430\u043B\u0430
    \u0433\u0435\u0439\u043C\u0434\u0436\u0435\u043C\u0430. \u0417\u0430\u0439\u0434\u044F
    \u0432 Discord \u044F \u0443\u0432\u0438\u0434\u0435\u043B, \u0447\u0442\u043E
    \u0432\u0441\u0435 \u0443\u0436\u0435 \u043D\u0430 \u043C\u0435\u0441\u0442\u0435
    \u0438 \u0433\u043E\u0442\u043E\u0432\u044F\u0442\u0441\u044F \u043A \u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u044E
    \u0442\u0435\u043C\u044B \u044D\u0442\u043E\u0433\u043E Event\u2019\u0430. \n\u041C\u043E\u0438
    \u0447\u0443\u0432\u0441\u0442\u0432\u0430 \u0431\u044B\u043B\u0438 \u0441\u043C\u0435\u0448\u0430\u043D\u044B:
    \u044F \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B \u0432\u043E\u043E\u0434\u0443\u0448\u0435\u0432\u043B\u0435\u043D\u0438\u0435
    \u0438 \u0447\u0442\u043E-\u0442\u043E \u0432\u0440\u043E\u0434\u0435 \u0441\u0442\u0440\u0430\u0445\u0430
    \u043F\u0435\u0440\u0435\u0434 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u043C.
    \u0418 \u0432\u043E\u0442 \u0447\u0430\u0441\u044B \u043F\u0440\u043E\u0431\u0438\u043B\u0438
    9:00 \u0438 \u0434\u043E\u043B\u0433\u043E\u0436\u0434\u0430\u043D\u043D\u043E\u0435
    \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435 \u043E\u0442 \u0420\u043E\u043C\u0430\u043D\u0430
    \u0421\u0430\u043A\u0443\u0442\u0438\u043D\u0430 \u043E\u0437\u0430\u0440\u0438\u043B\u043E
    \u043D\u0430\u0448\u0438 \u044D\u043A\u0440\u0430\u043D\u044B, \u0433\u043B\u0430\u0437\u0430
    \u043D\u0430\u0447\u0430\u043B\u0438 \u0431\u044B\u0441\u0442\u0440\u043E, \u043D\u043E
    \u0432\u043A\u0440\u0430\u0434\u0447\u0438\u0432\u043E, \u0431\u0435\u0433\u0430\u0442\u044C
    \u043F\u043E \u0441\u0442\u0440\u043E\u043A\u0430\u043C.\r\n\u0422\u0435\u043C\u043E\u0439
    \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C \u201C\u0412\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u0430\u044F
    \u041D\u043E\u0432\u0435\u043B\u043B\u0430\u201D. \n\u0421\u043D\u0430\u0447\u0430\u043B\u0430
    \u043C\u044B \u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u043F\u043E\u043D\u044F\u043B\u0438
    \u043A\u0430\u043A \u044D\u0442\u043E \u0440\u0435\u0430\u043B\u0438\u0437\u043E\u0432\u044B\u0432\u0430\u0442\u044C,
    \u043D\u043E \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u044B\u043C\u0438
    \u0443\u0441\u0438\u043B\u0438\u044F\u043C\u0438 \u0432\u044B\u0432\u0435\u043B\u0438
    \u043E\u0441\u043D\u043E\u0432\u043D\u0443\u044E \u0438\u0441\u0442\u043E\u0440\u0438\u044E,
    \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u043B\u0438 \u0437\u0430\u0434\u0430\u0447\u0438
    \u0438 \u043D\u0430\u0447\u0430\u043B\u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C*"
