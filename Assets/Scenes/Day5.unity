  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 915
  indentLevel: 1
  storyText: "\u041F\u0440\u0438\u0432\u0435\u0442, \u043D\u0435 \u043E\u0442\u0432\u043B\u0435\u043A\u0430\u044E?
    \u0425\u043E\u0442\u0435\u043B \u0441\u043A\u0430\u0437\u0430\u0442\u044C \u0441\u043F\u0430\u0441\u0438\u0431\u043E
    \u0442\u0435\u0431\u0435 \u0437\u0430 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0443.
    \u0417\u0423\u0421 \u0432 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435
    \u0437\u0430\u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u0432\u0430\u043B\u0441\u044F
    \u043C\u043E\u0438\u043C \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435\u043C
    \u0438 \u0434\u0430\u043B \u043C\u043D\u0435 \u0434\u0435\u043D\u0435\u0433,
    \u0447\u0442\u043E\u0431\u044B \u044F \u0441 \u0434\u043E\u043B\u0433\u0430\u043C\u0438
    \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u043B\u0441\u044F. \u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
    \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0435\u0431\u0435 \u0434\u043E\u043B\u0436\u043E\u043A
    \u0432\u0435\u0440\u043D\u0443\u0442\u044C)"
