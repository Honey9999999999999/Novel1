--- !u!114 &1090641173
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1090641086}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 249
  indentLevel: 0
  storyText: "\u041C\u044B \u0441\u0434\u0435\u043B\u0430\u043B\u0438 \u0438\u0433\u0440\u0443,
    \u0437\u0430\u043F\u0438\u0441\u0430\u043B\u0438 \u0432\u0438\u0434\u0435\u043E
    \u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0438 \u043D\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0443
    \u041A\u043E\u043C\u0438\u0441\u0441\u0438\u0438 \u0416\u044E\u0440\u0438\r\n\u041C\u044B
    \u0443\u0441\u0442\u0430\u043B\u0438. \u0412\u0441\u0451 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F
    \u043C\u044B \u043D\u0435 \u0441\u043F\u0430\u043B\u0438 \u0438 \u0440\u0435\u0434\u043A\u043E
    \u043E\u0442\u0432\u043B\u0435\u043A\u0430\u043B\u0438\u0441\u044C \u043D\u0430
    \u043B\u0438\u0447\u043D\u044B\u0435 \u0434\u0435\u043B\u0430. \u0412\u0441\u0451
    \u043D\u0430\u0448\u0435 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u0431\u044B\u043B\u043E
    \u043F\u0440\u0438\u043A\u043E\u0432\u0430\u043D\u043E \u043A \u0438\u0433\u0440\u0435.
    \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0442\u043E\u043C\u0443,
    \u0447\u0442\u043E \u044F \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B
    \u0443\u0440\u043E\u043A \u043F\u043E C# \u0438 \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B
    \u043F\u043E\u043C\u043E\u0449\u0438 Vondarm\u2019\u0430 \u0432 \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0438
    \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u044B\u0445 \u043C\u043D\u0435
    \u0432\u0435\u0449\u0435\u0439, \u044F \u0441\u043C\u043E\u0433 \u0440\u0435\u0430\u043B\u0438\u0437\u043E\u0432\u0430\u0442\u044C
    \u0438\u0434\u0435\u044E \u0438\u0433\u0440\u044B \u0432 \u043A\u043E\u0434\u0435.\r\n"
  description: 
  character: {fileID: 53376501}
  portrait: {fileID: 21300000, guid: cdeee9df30b7b5747bc8ae50f9634633, type: 3}
