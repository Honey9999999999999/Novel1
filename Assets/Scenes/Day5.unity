--- !u!114 &496177699
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 496177619}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 840
  indentLevel: 1
  storyText: "{i}\u041D\u0430 \u0438\u0433\u043B\u0443 \u0432\u0430\u0440\u0438\u0430\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438
    \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u044B\u0445 \u043D\u043E\u0432\u0435\u043B\u043B
    \u043D\u0435 \u0442\u0430\u043A \u0442\u0440\u0443\u0434\u043D\u043E \u0437\u0430\u0431\u0440\u0430\u0442\u044C\u0441\u044F,
    \u043A\u0430\u043A \u0442\u0440\u0443\u0434\u043D\u043E \u0441 \u043D\u0435\u0451
    \u0441\u043B\u0435\u0437\u0442\u044C.\n\u0412 \u043D\u0430\u0447\u0430\u043B\u0435
    \u041C\u043E\u0440\u0433\u0430\u043D, \u0432\u0437\u044F\u0432\u0448\u0438\u0439\u0441\u044F
    \u043F\u0438\u0441\u0430\u0442\u044C \u0441\u044E\u0436\u0435\u0442, \u0447\u0430\u0441\u0442\u043E
    \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u0432\u0430\u043B\u0441\u044F
    \"\u043C\u043E\u0436\u043D\u043E \u043B\u0438 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
    \u0442\u0430\u043A \u0438\u043B\u0438 \u044D\u0434\u0430\u043A\", \u043D\u043E
    \u043F\u043E\u043D\u044F\u0432, \u0447\u0442\u043E \u043A\u043E\u0434\u0443 \u0432
    \u043C\u043E\u0438\u0445 \u0440\u0443\u043A\u0430\u0445 \u043F\u043E\u0434\u0432\u043B\u0430\u0441\u0442\u043D\u043E
    \u0432\u0441\u0451, \u043E\u043D \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
    \u043D\u0430 \u0433\u0440\u0430\u043D\u0438 \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u0438\u044F
    \u043C\u043D\u043E\u0433\u043E\u0442\u043E\u043C\u043D\u0438\u043A\u0430."
