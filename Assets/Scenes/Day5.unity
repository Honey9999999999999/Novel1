--- !u!114 &1090641089
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1090641086}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 243
  indentLevel: 0
  storyText: "\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0432\u0440\u0435\u043C\u044F
    \u043C\u044B \u043F\u0440\u043E\u0436\u0434\u0430\u043B\u0438 \u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435
    \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043E\u0432 \u0434\u0430\u043D\u043D\u043E\u0433\u043E
    \u0433\u0435\u0439\u043C\u0434\u0436\u0435\u043C\u0430. \u0412 \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u043C
    \u0438\u0442\u043E\u0433\u0435 \u043D\u0430 \u043F\u0435\u0440\u0432\u043E\u0435
    \u043C\u0435\u0441\u0442\u043E \u043F\u044C\u0435\u0434\u0435\u0441\u0442\u0430\u043B\u0430
    \u0432\u0441\u0442\u0430\u043B\u0430 \u043D\u0430\u0448\u0430 \u0438\u0433\u0440\u0430!
    \u0421\u0447\u0430\u0441\u0442\u044C\u044E \u043D\u0435 \u0431\u044B\u043B\u043E
    \u043F\u0440\u0435\u0434\u0435\u043B\u0430, \u0432\u0435\u0434\u044C, \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044C,
    \u044D\u0442\u043E \u041F\u0415\u0420\u0412\u0410\u042F \u0438\u0433\u0440\u0430,
    \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043C\u044B \u0441\u0434\u0435\u043B\u0430\u043B\u0438!\r\n\u041C\u043E\u044F
    \u043C\u0435\u0447\u0442\u0430 \u0438\u0441\u043F\u043E\u043B\u043D\u0438\u043B\u0430\u0441\u044C,
    \u043D\u043E \u043D\u0430 \u044D\u0442\u043E\u043C \u044F \u043D\u0435 \u043F\u043B\u0430\u043D\u0438\u0440\u0443\u044E
    \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C\u0441\u044F\r\n\u0425\u043E\u0447\u0443
    \u0441\u043A\u0430\u0437\u0430\u0442\u044C \u043A\u0430\u0436\u0434\u043E\u043C\u0443
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443, \u0441 \u043A\u043E\u0442\u043E\u0440\u044B\u043C
    \u043C\u044B \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0438
    \u043D\u0430 \u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u0438\u0438 \u0432\u0441\u0435\u0433\u043E
    \u044D\u0442\u043E\u0433\u043E \u043F\u0443\u0442\u0438, \u201C\u0421\u041F\u0410\u0421\u0418\u0411\u041E!\u201D,
    \u0432\u0435\u0434\u044C \u0438\u043C\u0435\u043D\u043D\u043E \u043B\u044E\u0434\u0438
    \u0438 \u0438\u0445 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0438
    \u043D\u0430 \u043C\u0435\u043D\u044F \u0442\u0430\u043A\u043E\u0439 \u044D\u0444\u0444\u0435\u043A\u0442.\r\n"
