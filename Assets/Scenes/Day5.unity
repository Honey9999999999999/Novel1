  itemId: 250
  indentLevel: 0
  storyText: "*\u041C\u044B \u043F\u0440\u043E\u0434\u0435\u043B\u0430\u043B\u0438
    \u043E\u0433\u0440\u043E\u043C\u043D\u0443\u044E \u0440\u0430\u0431\u043E\u0442\u0443
    \u0437\u0430 2 \u0434\u043D\u044F. \u0423 \u043D\u0430\u0441 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0430\u0441\u044C
    \u043F\u0440\u043E\u0441\u0442\u043E \u0432\u0435\u043B\u0438\u043A\u043E\u043B\u0435\u043F\u043D\u0430\u044F
    \u0438\u0433\u0440\u0430!*\n"
