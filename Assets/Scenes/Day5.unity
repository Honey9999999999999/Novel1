  m_EditorClassIdentifier: 
  itemId: 454
  indentLevel: 0
  storyText: "{i}\u041F\u0440\u043E\u0441\u043D\u0443\u0432\u0448\u0438\u0441\u044C,
    \u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E \u0441\u0438\u043B\u044C\u043D\u043E\u0435
    \u0432\u043E\u043B\u043D\u0435\u043D\u0438\u0435. \u041C\u044B \u043F\u0440\u043E\u0432\u0435\u043B\u0438
    \u0443\u0442\u0440\u043E \u0437\u0430 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430\u043C\u0438
    \u0438 \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044F\u043C\u0438
    \u043E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0439 \u0442\u0435\u043C\u0435
    \u0434\u0436\u0435\u043C\u0430, \u0432 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u0438
    \u0435\u0451 \u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u044F."
