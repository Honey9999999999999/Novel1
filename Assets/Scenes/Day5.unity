  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 874
  indentLevel: 0
  storyText: "{i}\u041E\u0436\u0438\u0434\u0430\u043D\u0438\u0435 \u0434\u043B\u044F
    \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u043E\u0432, \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
    \u043C\u0443\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C. \u0412 \u0447\u0430\u0442\u0435
    \u043B\u0430\u0433\u0435\u0440\u044F \u0442\u043E \u0438 \u0434\u0435\u043B\u043E,
    \u0434\u0435\u043D\u044C \u0437\u0430 \u0434\u043D\u0451\u043C, \u0432\u043E\u0437\u043D\u0438\u043A\u0430\u043B\u0438
    \u0432\u043E\u043F\u0440\u043E\u0441\u044B \u043A\u0430\u0441\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043E\u0432 \u0434\u0430\u043D\u043D\u043E\u0433\u043E
    \u0433\u0435\u0439\u043C \u0434\u0436\u0435\u043C\u0430. \u0412 \u0438\u0442\u043E\u0433\u0435
    \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044C \u0431\u044B\u043B
    \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D \u0432 \u0442\u0435\u043B\u0435\u0433\u0440\u0430\u043C
    \u043A\u0430\u043D\u0430\u043B\u0435 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0442\u043E\u0440\u0430.
    \u041D\u0430 \u043F\u0435\u0440\u0432\u043E\u0435 \u043C\u0435\u0441\u0442\u043E
    \u043F\u044C\u0435\u0434\u0435\u0441\u0442\u0430\u043B\u0430 \u0432\u0441\u0442\u0430\u043B\u0430... "
