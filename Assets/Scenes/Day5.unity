  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 871
  indentLevel: 0
  storyText: "{i}\u0418\u0437\u043E\u0431\u0440\u0430\u0437\u0438\u0432 \u0432\u044B\u043C\u043E\u0442\u0430\u043D\u043D\u043E\u0441\u0442\u044C
    \u0440\u0430\u0431\u043E\u0447\u0438\u043C \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u043C
    \u0438 \"\u0438\u0441\u043A\u0440\u0435\u043D\u043D\u0438\u0439\" \u0438\u043D\u0442\u0435\u0440\u0435\u0441
    \u043A \u043E\u043F\u044B\u0442\u0443 \u0434\u0440\u0443\u0433\u0438\u0445 \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u043E\u0432
    Joly \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u043F\u0440\u043E\u0441\u0442\u043E
    \u0437\u0430\u0432\u043B\u0430\u0434\u0435\u043B \u0441\u0442\u0430\u0442\u0443\u0441\u043E\u043C
    \"\u043D\u0435\u043F\u043B\u043E\u0445\u043E\u0433\u043E \u043F\u0430\u0440\u043D\u044F\",
    \u043F\u043E\u0431\u0435\u0434\u0435 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
    \u043D\u0438\u043A\u0442\u043E \u0432\u043E\u0437\u0440\u0430\u0436\u0430\u0442\u044C
    \u043D\u0435 \u0441\u0442\u0430\u043D\u0435\u0442."
