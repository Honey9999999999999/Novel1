--- !u!114 &496177715
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 496177619}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 827
  indentLevel: 1
  storyText: "{i}\u0427\u0435\u0441\u0442\u043D\u043E \u0433\u043E\u0432\u043E\u0440\u044F,
    \u0431\u044B\u043B\u043E \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430\u0442\u0438\u0447\u043D\u043E
    \u043D\u0430\u0439\u0442\u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435
    \u043D\u0430\u0432\u044B\u043A\u0430\u043C \u043C\u043E\u0434\u0435\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
    \u043F\u0440\u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0435
    \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u043E\u0439 \u043D\u043E\u0432\u0435\u043B\u043B\u044B,
    \u043D\u043E \u0431\u043B\u0430\u0433\u043E Blender - \u044D\u0442\u043E \u043D\u0435
    \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u043E \u043E\u0431\u044A\u0451\u043C.\n\u041C\u043D\u0435
    \u043F\u043E\u0432\u0435\u0437\u043B\u043E \u043D\u0430\u0439\u0442\u0438 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0438\u0439
    \u043D\u0430\u0431\u043E\u0440 \u043C\u043E\u0434\u0435\u043B\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u043E\u0441\u044C \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
    \u0432 \u0440\u0430\u0437\u043D\u044B\u0435 \u043F\u043E\u0437\u044B \u0438 \u043E\u0442\u0440\u0435\u043D\u0434\u0435\u0440\u0438\u0442\u044C
    \u043D\u0430 \u0441\u043F\u0440\u0430\u0439\u0442\u044B."
  description: 
  character: {fileID: 1896540577}
  portrait: {fileID: 21300000, guid: bcc00d71384aace40beecda15f2b1384, type: 3}
