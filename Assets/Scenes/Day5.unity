  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 933
  indentLevel: 1
  storyText: "\u0412\u0438\u0434\u0435\u043B, \u0447\u0442\u043E \u0443 \u0442\u0435\u0431\u044F
    \u0442\u043E\u0436\u0435 \u0432\u0441\u0451 \u0445\u043E\u0440\u043E\u0448\u043E.
    \u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u044E \u0441 \u043F\u043E\u0431\u0435\u0434\u043E\u0439!
    \u0412\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438 \u0442\u043E, \u0447\u0442\u043E
    \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u043B\u0438. \u0410 \u044F \u043F\u043E\u043B\u0443\u0447\u0438\u043B
    \u0442\u043E, \u0432 \u0447\u0451\u043C \u043D\u0443\u0436\u0434\u0430\u043B\u0441\u044F.
    \u041F\u043E \u044D\u0442\u043E\u043C\u0443 \u0431\u0435\u0440\u0435\u0433\u0438
    \u0441\u0435\u0431\u044F. \u041C\u0430\u043B\u043E \u043B\u0438 \u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0435\u0449\u0451 \u0442\u0430\u043A\u0438\u0445 \u043D\u0443\u0436\u0434\u0430\u044E\u0449\u0438\u0445\u0441\u044F
    \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0448\u044C)"
  description: 
  character: {fileID: 1896540579}
  portrait: {fileID: 21300000, guid: e6d83e8064315334e9b661b73dd165f2, type: 3}
  voiceOverClip: {fileID: 0}
