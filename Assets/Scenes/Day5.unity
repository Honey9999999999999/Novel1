  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 834
  indentLevel: 1
  storyText: "{i}\u0415\u0441\u043B\u0438 \u0443\u043F\u0440\u043E\u0441\u0442\u0438\u0442\u044C,
    \u0442\u043E \u043A\u0430\u0436\u0434\u044B\u0439 \u0438\u0437 \u043D\u0430\u0441
    \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0441\u044F \u0432\u0441\u0435\u043C
    \u0441\u0440\u0430\u0437\u0443, \u0438 \u043C\u044B, \u043D\u0430 \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u0435,
    \u043E\u0431\u043E\u0448\u043B\u0438\u0441\u044C \u0431\u0435\u0437 \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442\u043E\u0432.\n\u041A\u043E\u043D\u0435\u0447\u043D\u043E,
    \u0435\u0441\u043B\u0438 \u043D\u0435 \u0443\u0447\u0438\u0442\u044B\u0432\u0430\u0442\u044C
    \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0435
    \u0432\u043E\u0440\u0447\u0430\u043D\u0438\u0435 \u0425\u0430\u043D\u0438, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u043E\u043D \u043F\u043E\u0437\u0438\u0446\u0438\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043B
    \u043A\u0430\u043A \"\u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u043B\u044F\u043B\u0438\u0441\u044C\"."
  description: 
  character: {fileID: 1896540577}
  portrait: {fileID: 21300000, guid: bcc00d71384aace40beecda15f2b1384, type: 3}
