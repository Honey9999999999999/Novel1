  m_EditorClassIdentifier: 
  itemId: 898
  indentLevel: 0
  storyText: "{i}\u0412\u0441\u0451 \u0442\u0430\u043A\u0438 \u043C\u043E\u044F \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442\u043D\u0430\u044F
    \u0446\u0435\u043B\u044C - \u044D\u0442\u043E \u0437\u043D\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u0430
    \u0438 \u0437\u043D\u0430\u043D\u0438\u044F, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043D\u0435 \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C \u043C\u043D\u043E\u0439
    \u0443\u043F\u0443\u0449\u0435\u043D\u044B. \u0423 \u043C\u0435\u043D\u044F \u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C
    \u043D\u0430\u0434\u0451\u0436\u043D\u0430\u044F \u043A\u043E\u043C\u0430\u043D\u0434\u0430
    \u0441 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u044F \u043C\u043E\u0433\u0443
    \u0432\u043E\u043F\u043B\u043E\u0449\u0430\u0442\u044C \u0438\u0433\u0440\u043E\u0432\u044B\u0435
    \u043C\u0435\u0447\u0442\u044B \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C.
    \u0415\u0441\u043B\u0438 \u043D\u0435 \u0441\u0435\u0433\u043E\u0434\u043D\u044F,
    \u0442\u043E \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043C. \u0415\u0441\u043B\u0438
    \u0443\u0436 \u043D\u0435 \u0441 \u043D\u0438\u043C\u0438, \u0442\u043E \u0445\u043E\u0442\u044F
