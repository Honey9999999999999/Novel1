--- !u!114 &496177721
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 496177619}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 821
  indentLevel: 0
  storyText: "{i}\u041C\u044B \u0442\u043E\u0436\u0435 \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
    \u0432 \u0437\u0430\u043C\u0435\u0448\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0435,
    \u043D\u043E Van1exx \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u0438\u0434\u0435\u044E.\n\u041E\u043D\u0430
    \u0431\u044B\u043B\u0430 \u0441\u0442\u043E\u043B\u044C \u0436\u0435 \u043F\u0440\u043E\u0441\u0442\u0430,
    \u043A\u0430\u043A \u043E\u0431\u0432\u0435\u0441\u0442\u0438 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E
    \u0440\u0443\u043A\u0443 \u043A\u0430\u0440\u0430\u043D\u0434\u0430\u0448\u043E\u043C,
    \u0432\u044B\u0434\u0430\u0432\u0430\u044F \u044D\u0442\u043E \u0437\u0430 \u0440\u0438\u0441\u0443\u043D\u043E\u043A.
    \n\u041E\u0434\u043D\u0430\u043A\u043E, \u0437\u0430 \u043D\u0435\u0438\u043C\u0435\u043D\u0438\u0435\u043C
    \u0431\u043E\u043B\u0435\u0435 \u0433\u0435\u043D\u0438\u0430\u043B\u044C\u043D\u044B\u0445
    \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0439, \u043C\u044B
    \u043D\u0430\u0447\u0430\u043B\u0438 \u0434\u0435\u043B\u0430\u0442\u044C \u0438\u0433\u0440\u0443
    \u043F\u0440\u043E \u043E\u0441\u0435\u043D\u043D\u0438\u0439 gamedev \u043B\u0430\u0433\u0435\u0440\u044C."
  description: 
  character: {fileID: 1896540577}
  portrait: {fileID: 21300000, guid: bcc00d71384aace40beecda15f2b1384, type: 3}
