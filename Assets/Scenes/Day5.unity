  storyText: "{i}\u0412 \u044D\u0442\u043E\u0442 \u043C\u043E\u043C\u0435\u043D\u0442
    \u0434\u0443\u0445\u043E\u0442\u0430 Honey \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
    \u043A\u0430\u043A \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043A \u043C\u0435\u0441\u0442\u0443."
