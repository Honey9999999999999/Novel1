  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 256
  indentLevel: 0
  storyText: "\u041D\u0430 \u044D\u0442\u043E\u043C \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F, \u043D\u043E \u043E\u0447\u0435\u043D\u044C
    \u0432\u0430\u0436\u043D\u0430\u044F \u0438\u0441\u0442\u043E\u0440\u0438\u044F
    \u043D\u0430\u0447\u0430\u043B\u0430 \u043C\u043E\u0435\u0433\u043E \u043F\u0443\u0442\u0438
    \u0432 \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0435 \u0438 \u043C\u043E\u0433\u0443
    \u0441\u043A\u0430\u0437\u0430\u0442\u044C, \u0447\u0442\u043E \u043D\u0435 \u0436\u0430\u043B\u0435\u044E
    \u043D\u0438 \u043E \u043A\u0430\u043A\u0438\u0445 \u043F\u0440\u0438\u043D\u044F\u0442\u044B\u0445
    \u0440\u0435\u0448\u0435\u043D\u0438\u044F\u0445.\r\n\u041D\u043E \u044D\u0442\u0430
    \u043C\u044B\u0441\u043B\u044C \u0432 \u043C\u043E\u0435\u0439 \u0433\u043E\u043B\u043E\u0432\u0435:
    \"\u0430 \u0447\u0442\u043E \u0435\u0441\u043B\u0438 \u0431\u044B \u044F \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u043B
    \u0438\u043D\u0430\u0447\u0435? \u041F\u0440\u0438\u0448\u0451\u043B \u0431\u044B
    \u044F \u043A \u044D\u0442\u043E\u043C\u0443 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0443,
    \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044F \u0438\u043D\u0430\u0447\u0435?
    \u0425\u043E\u0442\u0435\u043B \u0431\u044B \u044F \u044D\u0442\u043E \u0432\u044B\u044F\u0441\u043D\u0438\u0442\u044C..\"\n"
