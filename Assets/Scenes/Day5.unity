MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 496177619}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 910
  indentLevel: 0
  storyText: "{i}\u042F \u0434\u0430\u0436\u0435 \u043D\u0435 \u043C\u043E\u0433\u0443
    \u0432\u043E\u0441\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u044C \u044D\u0442\u043E
    \u043A\u0430\u043A \u043F\u043E\u0431\u0435\u0434\u0443. \u0423 \u043C\u0435\u043D\u044F
    \u0435\u0441\u0442\u044C \u0434\u0435\u043D\u044C\u0433\u0438 \u0438 \u0431\u043E\u043B\u044C\u0448\u0435
    \u043D\u0438\u0447\u0435\u0433\u043E. Joly \u0438 \u0421\u0423\u0417 \u043E\u0431\u043E\u0440\u0432\u0430\u043B\u0438
    \u0441\u043E \u043C\u043D\u043E\u0439 \u0441\u0432\u044F\u0437\u0438 \u043F\u043E\u0441\u043B\u0435
    \u0434\u0436\u0435\u043C\u0430, \u043B\u0430\u0433\u0435\u0440\u044C \u0432\u0441\u0451
    \u0435\u0449\u0451 \u0436\u0438\u0432\u0451\u0442 \u0441\u0432\u043E\u0435\u0439
    \u0436\u0438\u0437\u043D\u044C\u044E, \u0440\u0435\u0431\u044F\u0442\u0430 \u0437\u0430\u0434\u043E\u0440\u043D\u043E
    \u043E\u0431\u0449\u0430\u044E\u0442\u0441\u044F \u043D\u0435 \u0441\u043C\u043E\u0442\u0440\u044F
    \u043D\u0430 \u0441\u0432\u043E\u0439 \u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0448.
    \u041C\u043D\u0435 \u0434\u0430\u0436\u0435 \u043E\u0442 \u0438\u0434\u0435\u0438,
    \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0441 \u043D\u0438\u043C\u0438,
    \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043D\u0435 \u043F\u043E
    \u0441\u0435\u0431\u0435. \u0425\u043E\u0442\u044F, \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
    \u0431\u044B, \u043A\u0443\u0434\u0430 \u0445\u0443\u0436\u0435...."
  description: 
  character: {fileID: 1896540577}
  portrait: {fileID: 21300000, guid: bcc00d71384aace40beecda15f2b1384, type: 3}
